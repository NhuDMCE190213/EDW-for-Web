@page "/auth/set-new-password"
@layout AuthLayout
@using Admin.Blazor.Components.Layout
@using BLL.Services.Interfaces
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@inject IStaffService StaffService
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<h3 class="fw-bold text-dark mb-1">Set New Password</h3>
<p class="text-muted small mb-4">Choose a new password for your admin account</p>

<EditForm Model="Input" OnValidSubmit="HandleSetPassword" FormName="SetNewPasswordForm" class="text-start">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label fw-semibold text-dark small mb-2">New Password</label>
        <div class="input-group auth-input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
            <InputText @bind-Value="Input.Password" type="password" class="form-control bg-light border-start-0 ps-1" placeholder="Enter new password" />
        </div>
        <div class="mt-1 small">
            <ValidationMessage For="() => Input.Password" class="text-danger" />
        </div>
    </div>

    <div class="mb-4">
        <label class="form-label fw-semibold text-dark small mb-2">Confirm Password</label>
        <div class="input-group auth-input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-check"></i></span>
            <InputText @bind-Value="Input.ConfirmPassword" type="password" class="form-control bg-light border-start-0 ps-1" placeholder="Confirm new password" />
        </div>
        <div class="mt-1 small">
            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert auth-alert-danger border-0 d-flex align-items-center gap-2 mb-4 small" role="alert">
            <i class="bi bi-exclamation-circle-fill"></i>
            <div>@ErrorMessage</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert auth-alert-success border-0 d-flex align-items-center gap-2 mb-4 small" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@SuccessMessage</div>
        </div>
    }

    <button type="submit" class="btn btn-danger w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm auth-btn-primary mb-3" disabled="@isLoading">
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        }
        else
        {
            <span>Set Password</span>
        }
    </button>

    <div class="text-center mt-3">
        <a href="/auth/login" class="auth-link small fw-semibold text-decoration-none d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Login
        </a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromQuery]
    private string Email { get; set; } = string.Empty;

    [SupplyParameterFromForm]
    private SetNewPasswordInput Input { get; set; } = new();
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool isLoading { get; set; }

    private async Task HandleSetPassword()
    {
        isLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        // Basic request validation: email must be present (passed from forgot-password)
        if (string.IsNullOrWhiteSpace(Email))
        {
            ErrorMessage = "Invalid request. Please start from the forgot password page.";
            isLoading = false;
            return;
        }

        // Lookup staff and set hashed password via BLL service
        var staff = await StaffService.GetByEmailAsync(Email);
        if (staff == null)
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        // SetPasswordAsync will hash the password and update the repository
        await StaffService.SetPasswordAsync(staff.StaffId, Input.Password);
        SuccessMessage = "Password updated successfully.";
        isLoading = false;

        // Redirect to login after a short delay
        await Task.Delay(1500);
        Navigation.NavigateTo("/auth/login");
    }

    public class SetNewPasswordInput
    {
        [Required(ErrorMessage = "Password is required.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters.")]
        [RegularExpression(@"^(?=.*[a-zA-Z])(?=.*\d)(?=.*[!@#$%^&*()_+\-=\[\]{};':""\\|,.<>\/?]).+$",
            ErrorMessage = "Password must contain at least one letter, one number, and one special character.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare("Password", ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
