@page "/auth/change-password"
@using BLL.DTOs.Staff
@using BLL.Services.Interfaces
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@inject IStaffService StaffService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

@attribute [Authorize(Roles = "Admin")]

<div class="p-4 bg-white rounded-3 shadow-sm custom-profile-card mt-3">
    <div class="d-flex align-items-center gap-2 mb-2">
        <div class="red-line-indicator"></div>
        <h4 class="fw-bold text-dark mb-0 fs-5">Security & Password</h4>
    </div>
    <p class="text-muted small mb-4">Update your password to keep your administrator account secure</p>

    <EditForm Model="Input" OnValidSubmit="HandleChangePassword" FormName="ChangePasswordForm">
        <DataAnnotationsValidator />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold text-secondary small mb-2">New Password</label>
                <div class="input-group custom-layout-input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                    <InputText @bind-Value="Input.NewPassword" type="password" class="form-control bg-light border-start-0 ps-1" placeholder="Enter new password" />
                </div>
                <div class="mt-1 small">
                    <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold text-secondary small mb-2">Confirm Password</label>
                <div class="input-group custom-layout-input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-check"></i></span>
                    <InputText @bind-Value="Input.ConfirmPassword" type="password" class="form-control bg-light border-start-0 ps-1" placeholder="Confirm new password" />
                </div>
                <div class="mt-1 small">
                    <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger custom-layout-alert border-0 d-flex align-items-center gap-2 my-3 small" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i>
                <div>@ErrorMessage</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success custom-layout-alert-success border-0 d-flex align-items-center gap-2 my-3 small" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@SuccessMessage</div>
            </div>
        }

        <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top border-light">
            <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm custom-layout-btn-danger" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span>Save Password</span>
                }
            </button>

            <a href="/profile" class="btn btn-outline-secondary px-4 py-2 fw-semibold custom-layout-btn-outline text-decoration-none d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i> Back to Profile
            </a>
        </div>
    </EditForm>
</div>

<style>
    /* Card bọc ngoài đồng bộ với phần Profile Information */
    .custom-profile-card {
        border: 1px solid #f1f3f5;
        max-width: 900px;
    }

    /* Vạch màu đỏ trang trí đầu tiêu đề */
    .red-line-indicator {
        width: 3px;
        height: 18px;
        background-color: #d90429;
        border-radius: 2px;
    }

    /* Định dạng ô nhập liệu phẳng chìm nền xám nhẹ */
    .custom-layout-input-group .input-group-text,
    .custom-layout-input-group .form-control {
        background-color: #f8f9fa !important;
        border-color: #e9ecef !important;
        padding-top: 0.6rem;
        padding-bottom: 0.6rem;
        font-size: 0.95rem;
        color: #495057 !important;
    }

        .custom-layout-input-group .form-control:focus {
            box-shadow: none;
            border-color: #dee2e6 !important;
        }

    /* Nút lưu màu đỏ chủ đạo */
    .custom-layout-btn-danger {
        background-color: #d90429 !important;
        border: none;
        border-radius: 6px;
        font-size: 0.95rem;
    }

        .custom-layout-btn-danger:hover {
            background-color: #b30322 !important;
        }

    /* Nút quay lại dạng outline */
    .custom-layout-btn-outline {
        border-color: #dee2e6 !important;
        color: #495057 !important;
        border-radius: 6px;
        font-size: 0.95rem;
        background-color: #fff;
    }

        .custom-layout-btn-outline:hover {
            background-color: #f8f9fa !important;
            border-color: #ced4da !important;
        }

    /* Hộp cảnh báo */
    .custom-layout-alert {
        background-color: #fff5f5;
        color: #e53e3e;
        border-radius: 6px;
    }

    .custom-layout-alert-success {
        background-color: #f0fdf4;
        color: #16a34a;
        border-radius: 6px;
    }
</style>

@code {
    [SupplyParameterFromForm]
    private StaffChangePasswordDto Input { get; set; } = new();

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool isLoading { get; set; }

    private async Task HandleChangePassword()
    {
        isLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        var httpContext = HttpContextAccessor.HttpContext;
        var email = httpContext?.User.FindFirst(ClaimTypes.Email)?.Value;
        if (string.IsNullOrEmpty(email))
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        var staff = await StaffService.GetByEmailAsync(email);
        if (staff == null)
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        await StaffService.SetPasswordAsync(staff.StaffId, Input.NewPassword);
        SuccessMessage = "Password changed successfully.";
        isLoading = false;

        await Task.Delay(1500);
        Navigation.NavigateTo("/profile");
    }
}