@page "/promotions/create"
@using Admin.Blazor.Hubs
@using BLL.DTOs.Promotion
@using BLL.DTOs.Validators
@using BLL.Services.Interfaces
@using DAL.Enums
@using Microsoft.AspNetCore.Authorization
@using FluentValidation
@using Microsoft.AspNetCore.SignalR
@rendermode InteractiveServer
@inject IPromotionService PromotionService
@inject NavigationManager NavigationManager
@inject IValidator<PromotionCreateDto> Validator
@inject IHubContext<AdminHub> HubContext

@attribute [Authorize(Roles = "Admin")]

<div class="modal-header">
    <h5 class="modal-title fw-bold">Create Promotion</h5>
    <button type="button" class="btn-close" @onclick="OnCancel"></button>
</div>

<div class="modal-body">
    <div class="row g-3">

        <!-- Name -->
        <div class="col-md-12">
            <label class="form-label fw-semibold">
                Promotion Name <span class="text-danger">*</span>
            </label>
            <input class="form-control @(HasValidationError(nameof(promotionCreateDto.Name)) ? "is-invalid" : "")"
                   placeholder="Enter promotion name..." @bind="promotionCreateDto.Name" />
            @if (HasValidationError(nameof(promotionCreateDto.Name)))
            {
                <div class="invalid-feedback">@GetValidationError(nameof(promotionCreateDto.Name))</div>
            }
        </div>

        <!-- Type -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Promotion Type <span class="text-danger">*</span>
            </label>
            <select class="form-select @(HasValidationError(nameof(promotionCreateDto.PromotionType)) ? "is-invalid" : "")"
                    @bind="promotionCreateDto.PromotionType">
                @foreach (var type in Enum.GetValues<PromotionTypeEnum>())
                {
                    <option value="@type">@type</option>
                }
            </select>
            @if (HasValidationError(nameof(promotionCreateDto.PromotionType)))
            {
                <div class="invalid-feedback">@GetValidationError(nameof(promotionCreateDto.PromotionType))</div>
            }
        </div>

        <!-- Value based on type -->
        <div class="col-md-6">
            @if (promotionCreateDto.PromotionType == PromotionTypeEnum.Percentage)
            {
                <!--Percentage-->
                <div>
                    <label class="form-label fw-semibold">
                        Percentage (%) <span class="text-danger">*</span>
                    </label>
                    <input type="number"
                           class="form-control @(HasValidationError(nameof(promotionCreateDto.Percentage)) ? "is-invalid" : "")"
                           placeholder="Enter percentage (0-100)" @bind="promotionCreateDto.Percentage" />
                    @if (HasValidationError(nameof(promotionCreateDto.Percentage)))
                    {
                        <div class="invalid-feedback">@GetValidationError(nameof(promotionCreateDto.Percentage))</div>
                    }
                </div>
            }
            else if (promotionCreateDto.PromotionType == PromotionTypeEnum.FixedAmount)
            {
                <!--Sale Price-->
                <div>
                    <label class="form-label fw-semibold">
                        Sale Price <span class="text-danger">*</span>
                    </label>
                    <input type="number"
                           class="form-control @(HasValidationError(nameof(promotionCreateDto.SalePrice)) ? "is-invalid" : "")"
                           placeholder="Enter sale price" @bind="promotionCreateDto.SalePrice" />
                    @if (HasValidationError(nameof(promotionCreateDto.SalePrice)))
                    {
                        <div class="invalid-feedback">@GetValidationError(nameof(promotionCreateDto.SalePrice))</div>
                    }
                </div>

                <!--ThresholdPrice-->
                <div class="mt-3">
                    <label class="form-label fw-semibold">
                        Threshold Price <span class="text-danger">*</span>
                    </label>
                    <input type="number"
                           class="form-control @(HasValidationError(nameof(promotionCreateDto.ThresholdPrice)) ? "is-invalid" : "")"
                           placeholder="Enter threshold price" @bind="promotionCreateDto.ThresholdPrice" />
                    @if (HasValidationError(nameof(promotionCreateDto.ThresholdPrice)))
                    {
                        <div class="invalid-feedback">@GetValidationError(nameof(promotionCreateDto.ThresholdPrice))</div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted mt-2">
                    <i class="bi bi-info-circle"></i> Please select a promotion type first
                </div>
            }
        </div>

        <!--Time-->
        <div class="col-md-12">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" @bind="promotionCreateDto.IsLimitedTime" id="isLimitedTime" />
                <label class="form-check-label fw-semibold" for="isLimitedTime">
                    Is Limited Time
                </label>
            </div>

            <label class="form-label fw-semibold">
                Duration @if (promotionCreateDto.IsLimitedTime)
                {
                    <span class="text-danger">*</span>
                }
            </label>

            <div class="row g-2">
                <div class="col-5">
                    <input type="datetime-local"
                           disabled="@(!promotionCreateDto.IsLimitedTime)"
                           class="form-control @(HasValidationError(nameof(promotionCreateDto.StartAt)) ? "is-invalid" : "")"
                           @bind="promotionCreateDto.StartAt" />
                    @if (HasValidationError(nameof(promotionCreateDto.StartAt)))
                    {
                        <div class="invalid-feedback">@GetValidationError(nameof(promotionCreateDto.StartAt))</div>
                    }
                </div>

                <div class="col-2 d-flex align-items-center justify-content-center">
                    <span class="fw-bold">-</span>
                </div>

                <div class="col-5">
                    <input type="datetime-local"
                           disabled="@(!promotionCreateDto.IsLimitedTime)"
                           class="form-control @(HasValidationError(nameof(promotionCreateDto.EndAt)) ? "is-invalid" : "")"
                           @bind="promotionCreateDto.EndAt" />
                    @if (HasValidationError(nameof(promotionCreateDto.EndAt)))
                    {
                        <div class="invalid-feedback">@GetValidationError(nameof(promotionCreateDto.EndAt))</div>
                    }
                </div>
            </div>
        </div>

        <!--Stock-->
        <div class="col-md-6">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" @bind="promotionCreateDto.IsReservedStock" id="isReservedStock" />
                <label class="form-check-label fw-semibold" for="isReservedStock">
                    Is Reserved Stock
                </label>
            </div>

            <label class="form-label fw-semibold">
                Stock @if (promotionCreateDto.IsReservedStock)
                {
                <span class="text-danger">*</span>
                }
            </label>
            <div>
                <input type="number"
                       disabled="@(!promotionCreateDto.IsReservedStock)"
                       class="form-control @(HasValidationError(nameof(promotionCreateDto.MaxReservedStock)) ? "is-invalid" : "")"
                       placeholder="Enter stock quantity" @bind="promotionCreateDto.MaxReservedStock" />
                @if (HasValidationError(nameof(promotionCreateDto.MaxReservedStock)))
                {
                    <div class="invalid-feedback">@GetValidationError(nameof(promotionCreateDto.MaxReservedStock))</div>
                }
            </div>
            @if (HasValidationError(nameof(promotionCreateDto.IsReservedStock)))
            {
                <div class="text-danger small mt-1">@GetValidationError(nameof(promotionCreateDto.IsReservedStock))</div>
            }
        </div>

        <!--id disable-->
        <div class="col-md-6">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" @bind="promotionCreateDto.IsDisable" id="isDisable" />
                <label class="form-check-label fw-semibold" for="isDisable">
                    Is Disable
                </label>
            </div>
        </div>

        <!-- Error Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="col-12">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            </div>
        }

        @if (validationErrors.Any())
        {
            <div class="col-12">
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>Please fix the following errors:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var error in validationErrors)
                        {
                            @foreach (var message in error.Value)
                            {
                                <li>@message</li>
                            }
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal-footer">
    <button class="btn btn-secondary" @onclick="OnCancel">
        Cancel
    </button>
    <button class="btn btn-danger" @onclick="Create" disabled="@isSubmitting">
        @if (isSubmitting)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
        }
        Create Promotion
    </button>
</div>

@code {
    [Parameter]
    public EventCallback OnCreated { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string errorMessage = string.Empty;
    private bool isSubmitting = false;
    private Dictionary<string, List<string>> validationErrors = new();

    private PromotionCreateDto promotionCreateDto = new PromotionCreateDto
    {
        StartAt = DateTime.Now,
        EndAt = DateTime.Now.AddDays(7)
    };

    private async Task Create()
    {
        try
        {
            isSubmitting = true;
            errorMessage = string.Empty;
            validationErrors.Clear();

            // Validate using FluentValidation
            var validationResult = await Validator.ValidateAsync(promotionCreateDto);

            if (!validationResult.IsValid)
            {
                foreach (var error in validationResult.Errors)
                {
                    if (!validationErrors.ContainsKey(error.PropertyName))
                    {
                        validationErrors[error.PropertyName] = new List<string>();
                    }
                    validationErrors[error.PropertyName].Add(error.ErrorMessage);
                }

                // Focus on first error
                var firstError = validationResult.Errors.FirstOrDefault();
                if (firstError != null)
                {
                    errorMessage = $"Validation failed: {firstError.ErrorMessage}";
                }
                return;
            }

            // Call service to create promotion
            await PromotionService.CreatePromotionAsync(promotionCreateDto);

            await HubContext.Clients.All.SendAsync("PromotionChanged");

            // Success - notify parent
            await OnCreated.InvokeAsync();
        }
        catch (ValidationException ex)
        {
            // Handle validation exception from service
            foreach (var error in ex.Errors)
            {
                if (!validationErrors.ContainsKey(error.PropertyName))
                {
                    validationErrors[error.PropertyName] = new List<string>();
                }
                validationErrors[error.PropertyName].Add(error.ErrorMessage);
            }
            errorMessage = "Validation failed. Please check the form.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool HasValidationError(string field)
    {
        return validationErrors.ContainsKey(field);
    }

    private string GetValidationError(string field)
    {
        if (validationErrors.TryGetValue(field, out var errors))
        {
            return string.Join(", ", errors);
        }
        return string.Empty;
    }

    private void ClearError(string field)
    {
        if (validationErrors.ContainsKey(field))
        {
            validationErrors.Remove(field);
        }
    }
}