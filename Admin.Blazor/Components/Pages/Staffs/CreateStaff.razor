@page "/staff_management/create"
@using Admin.Blazor.Hubs
@using BLL.DTOs.Staff
@using BLL.Services.Interfaces
@using DAL.Enums
@using FluentValidation
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR
@inject IValidator<StaffCreateDto> Validator
@rendermode InteractiveServer
@inject IStaffService StaffService
@inject NavigationManager NavigationManager
@inject IHubContext<AdminHub> HubContext

@attribute [Authorize(Roles = "Admin")]

<div class="modal-header">
    <h5 class="modal-title fw-bold">Create Staff</h5>

    <button type="button"
            class="btn-close"
            @onclick="OnCancel">
    </button>
</div>

<div class="modal-body">

    <div class="row g-3">

        <!-- Name -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Full Name <span class="text-danger">*</span>
            </label>

            <input class="form-control @(HasValidationError(nameof(staffCreateDto.FullName)) ? "is-invalid" : "")"
                   placeholder="Enter full name..." @bind="staffCreateDto.FullName" />
            @if (HasValidationError(nameof(staffCreateDto.FullName)))
            {
                <div class="invalid-feedback">@GetValidationError(nameof(staffCreateDto.FullName))</div>
            }
        </div>

        <!-- email -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Email <span class="text-danger">*</span>
            </label>

            <input class="form-control @(HasValidationError(nameof(staffCreateDto.Email)) ? "is-invalid" : "")"
                   placeholder="Enter email..." @bind="staffCreateDto.Email" />
            @if (HasValidationError(nameof(staffCreateDto.Email)))
            {
                <div class="invalid-feedback">@GetValidationError(nameof(staffCreateDto.Email))</div>
            }
        </div>

        <!--Pass-->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Password <span class="text-danger">*</span>
            </label>

            <input class="form-control @(HasValidationError(nameof(staffCreateDto.Password)) ? "is-invalid" : "")" placeholder="Enter password..." @bind="staffCreateDto.Password" />
            @if (HasValidationError(nameof(staffCreateDto.Password)))
            {
                <div class="invalid-feedback">@GetValidationError(nameof(staffCreateDto.Password))</div>
            }
        </div>

        <!--Role-->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Staff Role
            </label>
            <select class=" form-control" @bind="staffCreateDto.Role">
                @foreach (var role in Enum.GetValues<RoleEnum>().Where(r => r != RoleEnum.Customer))
                {
                    <option selected="@IsRoleSelected(staffCreateDto.Role, role)" value="@role">@role</option>
                }
            </select>
        </div>

        <!--isactive-->
        <div class="col-md-6">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" @bind="staffCreateDto.IsActive" id="isActiveCheck" />
                <label class="form-check-label fw-semibold" for="isActiveCheck">
                    Staff Is Active
                </label>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-md-12" style="color: red;">@errorMessage</div>
        </div>
    </div>
</div>

<div class="modal-footer">

    <button class="btn btn-secondary"
            @onclick="OnCancel">
        Cancel
    </button>

    <button class="btn btn-danger" @onclick="Create">
        Create Staff
    </button>

</div>

@code {
    [Parameter]
    public EventCallback OnCreated { get; set; }
    [Parameter]
    public EventCallback OnCancel { get; set; }
    private string errorMessage = string.Empty;

    private StaffCreateDto staffCreateDto = new StaffCreateDto();
    private Dictionary<string, List<string>> validationErrors = new();

    private async Task Create()
    {
        try
        {
            errorMessage = string.Empty;
            validationErrors.Clear();

            var result = await Validator.ValidateAsync(staffCreateDto);
            if (!result.IsValid)
            {
                foreach (var err in result.Errors)
                {
                    if (!validationErrors.ContainsKey(err.PropertyName))
                        validationErrors[err.PropertyName] = new List<string>();
                    validationErrors[err.PropertyName].Add(err.ErrorMessage);
                }

                var first = result.Errors.FirstOrDefault();
                if (first != null) errorMessage = $"Validation failed: {first.ErrorMessage}";
                return;
            }

            await StaffService.CreateAsync(staffCreateDto);
            await HubContext.Clients.All.SendAsync("StaffChanged");
            await OnCreated.InvokeAsync();
        }
        catch (FluentValidation.ValidationException vex)
        {
            foreach (var err in vex.Errors)
            {
                if (!validationErrors.ContainsKey(err.PropertyName))
                    validationErrors[err.PropertyName] = new List<string>();
                validationErrors[err.PropertyName].Add(err.ErrorMessage);
            }
            errorMessage = "Validation failed";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private bool HasValidationError(string field) => validationErrors.ContainsKey(field);
    private string GetValidationError(string field) => validationErrors.TryGetValue(field, out var errs) ? string.Join(", ", errs) : string.Empty;

    private bool IsRoleSelected(RoleEnum staff, RoleEnum role)
    {
        if (staff == role)
        {
            return true;
        }
        return false;
    }
}