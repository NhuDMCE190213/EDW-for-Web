@page "/profile"
@using BLL.DTOs.Staff
@using BLL.Services.Interfaces
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@inject IStaffService StaffService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Profile> Logger

@attribute [Authorize(Roles = "Admin")]

<div class="profile-page-wrapper p-4 min-vh-100">
    <div class="d-flex align-items-center gap-3 mb-4 ps-2">
        <div class="bg-danger rounded-3 p-2 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 42px; height: 42px;">
            <i class="bi bi-person-fill fs-4"></i>
        </div>
        <div>
            <h4 class="fw-bold text-dark mb-0">My Profile</h4>
            <p class="text-muted mb-0 small" style="font-size: 0.85rem;">Manage your personal information and preferences</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @SuccessMessage
        </div>
    }

    <div class="row g-4">
        
        <div class="col-lg-3 col-md-4">
            <div class="avatar-card text-center text-white p-4 shadow-sm position-relative">
                <div class="mx-auto rounded-circle border border-secondary border-2 d-flex align-items-center justify-content-center fw-bold mb-3" style="width: 90px; height: 90px; font-size: 1.8rem; background-color: rgba(255,255,255,0.05); letter-spacing: 1px;">
                    AD
                </div>
                <div class="position-absolute bg-danger rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 26px; height: 26px; top: 85px; left: calc(50% + 22px);">
                    <i class="bi bi-camera-fill text-white" style="font-size: 0.75rem;"></i>
                </div>
                <h5 class="fw-bold mb-1">@fullName</h5>
                <span class="badge bg-danger rounded-pill px-3 py-1 text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">@RoleText</span>
            </div>

            <div class="meta-card bg-white border-0 shadow-sm p-3">
                <div class="meta-item py-2 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-envelope text-secondary fs-5"></i>
                        <div>
                            <div class="text-secondary small-label">Email</div>
                            <div class="text-dark fw-medium truncate-text">@Input.Email</div>
                        </div>
                    </div>
                </div>

                <div class="meta-item py-2 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-calendar3 text-secondary fs-5"></i>
                        <div>
                            <div class="text-secondary small-label">Member Since</div>
                            <div class="text-dark fw-medium">@CreatedAtText</div>
                        </div>
                    </div>
                </div>

                <div class="meta-item py-2 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-shield-check text-secondary fs-5"></i>
                        <div>
                            <div class="text-secondary small-label">Status</div>
                            <div>
                                <span class="badge bg-success-subtle text-success px-2 py-1 rounded">@StatusText</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="meta-item py-2">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-clock-history text-secondary fs-5"></i>
                        <div>
                            <div class="text-secondary small-label">Last Updated</div>
                            <div class="text-dark fw-medium small-time">@UpdatedAtText</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9 col-md-8">
            <div class="card border-0 shadow-sm p-4 bg-white h-100 d-flex flex-column justify-content-between">
                
                <form @onsubmit="HandleUpdate" class="w-100">
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark border-start border-danger border-3 ps-2 mb-1" style="line-height: 1.2;">Profile Information</h5>
                        <p class="text-muted small ps-2 mb-0">Update your personal information and preferences</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small-label">Email</label>
                            <input type="text" class="form-control custom-input bg-light" value="@Input.Email" readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small-label">Full Name</label>
                            <input type="text" class="form-control custom-input" @bind="fullName" @bind:event="oninput" placeholder="Admin User" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small-label">Role</label>
                            <input type="text" class="form-control custom-input bg-light-disabled text-muted" value="@RoleText" readonly />
                        </div>
                    </div>

                    <div class="row mt-5 pt-4 border-top">
                        <div class="col-sm-6 mb-2 mb-sm-0">
                            <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 custom-btn-save" disabled="@isLoading">
                                @if (isLoading) { <span class="spinner-border spinner-border-sm"></span> }
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                        <div class="col-sm-6">
                            <a href="/auth/change-password" class="btn btn-outline-secondary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 custom-btn-password">
                                <i class="bi bi-lock"></i> Change Password
                            </a>
                        </div>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

<style>
    /* Tổng quan nền trang xám nhạt nhẹ nhàng */
    .profile-page-wrapper {
        background-color: #f9fafb;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* Thiết kế thẻ Đen Avatar bên trái */
    .avatar-card {
        background-color: #111827;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }

    /* Thẻ thông tin liền kề bên dưới */
    .meta-card {
        border-bottom-left-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    /* Tiêu đề nhãn nhỏ */
    .small-label {
        font-size: 0.75rem;
        font-weight: 500;
        margin-bottom: 2px;
    }

    /* Cắt chữ dài nếu email vượt khung */
    .truncate-text {
        max-width: 170px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.85rem;
    }
    .small-time {
        font-size: 0.82rem;
    }

    /* Custom Input định dạng bo góc mượt mà */
    .custom-input {
        border-color: #e5e7eb;
        padding: 0.6rem 0.75rem;
        font-size: 0.9rem;
        border-radius: 6px;
    }
    .custom-input:focus {
        border-color: #d90429;
        box-shadow: 0 0 0 2px rgba(217, 4, 41, 0.15);
    }
    .bg-light-disabled {
        background-color: #f3f4f6 !important;
    }

    /* Custom Nút Lưu */
    .custom-btn-save {
        background-color: #d90429 !important;
        border: none;
        border-radius: 6px;
    }
    .custom-btn-save:hover {
        background-color: #b30322 !important;
    }

    /* Custom Nút Đổi mật khẩu */
    .custom-btn-password {
        border-color: #e5e7eb !important;
        color: #374151 !important;
        background-color: #fff;
        border-radius: 6px;
    }
    .custom-btn-password:hover {
        background-color: #f9fafb !important;
    }
</style>

@code {
    private StaffProfileDto Input { get; set; } = new StaffProfileDto();
    private string? SuccessMessage { get; set; }
    private bool isLoading { get; set; }
    private string StatusText { get; set; } = string.Empty;
    private string RoleText { get; set; } = string.Empty;
    private string CreatedAtText { get; set; } = string.Empty;
    private string UpdatedAtText { get; set; } = string.Empty;
    private bool _initialized = false;
    private string fullName = string.Empty;

    private async Task LoadProfileAsync()
    {
        var email = HttpContextAccessor.HttpContext?.User.FindFirst(ClaimTypes.Email)?.Value;
        if (string.IsNullOrEmpty(email)) return;

        var staff = await StaffService.GetByEmailAsync(email);
        if (staff != null)
        {
            Input.StaffId = staff.StaffId;
            Input.Email = staff.Email;
            Input.FullName = staff.FullName;
            fullName = staff.FullName;
            Input.IsActive = staff.IsActive;
            Input.CreatedAt = staff.CreatedAt;
            Input.UpdatedAt = staff.UpdatedAt;
            StatusText = staff.IsActive ? "Active" : "Inactive";
            RoleText = "Administrator"; // Đồng bộ text hiển thị theo ảnh mẫu
            CreatedAtText = staff.CreatedAt.ToString("yyyy-MM-dd");
            UpdatedAtText = staff.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_initialized)
        {
            await LoadProfileAsync();
            _initialized = true;
        }
    }

    private async Task HandleUpdate()
    {
        isLoading = true;
        SuccessMessage = null;
        Input.FullName = fullName;

        var httpContext = HttpContextAccessor.HttpContext;
        var email = httpContext?.User.FindFirst(ClaimTypes.Email)?.Value;
        if (string.IsNullOrEmpty(email))
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        var staffId = Input.StaffId;
        if (staffId <= 0)
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        var profileDto = new StaffProfileDto
        {
            StaffId = staffId,
            Email = Input.Email,
            FullName = Input.FullName,
            IsActive = Input.IsActive,
            CreatedAt = Input.CreatedAt,
            UpdatedAt = Input.UpdatedAt
        };

        try
        {
            var result = await StaffService.UpdateProfileAsync(staffId, profileDto);
            if (result)
            {
                Input.UpdatedAt = DateTime.UtcNow;
                UpdatedAtText = Input.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never";
                SuccessMessage = "Profile updated successfully.";
                StateHasChanged();
            }
            else
            {
                SuccessMessage = "Failed to update profile.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while updating profile for staff id {StaffId}", staffId);
            SuccessMessage = "Failed to update profile.";
        }
        finally
        {
            isLoading = false;
        }
    }
}