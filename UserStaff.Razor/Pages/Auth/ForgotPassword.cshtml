@page
@model Staff.Razor.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="auth-card-header">
    <h4>Forgot Password</h4>
    <p>Enter your email to reset your staff account password</p>
</div>

<form method="post">
    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
    <div class="mb-3">
        <label for="Email" class="form-label small fw-semibold">Email</label>
        <input asp-for="Email" class="form-control" id="Email" placeholder="you@company.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-auth-primary w-100 py-2">Reset Password</button>
    <div class="text-center mt-3">
        <a asp-page="/Auth/Login" class="auth-link">
            <i class="bi bi-arrow-left"></i> Back to Login
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
