@page
@model Staff.Razor.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Staff Login";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="auth-card-header">
    <h4>Staff Sign In</h4>
    <p>Sign in to manage products, orders and reviews</p>
</div>

<form method="post">
    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label small fw-semibold"></label>
        <input asp-for="Input.Email" class="form-control" placeholder="you@company.com" />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label small fw-semibold"></label>
        <input asp-for="Input.Password" class="form-control" type="password" placeholder="Enter your password" />
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-auth-primary w-100 py-2">Sign In</button>
    <div class="text-center mt-3">
        <a asp-page="/Auth/ForgotPassword" class="auth-link">Forgot password?</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}