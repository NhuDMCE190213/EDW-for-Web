@page
@model Staff.Razor.Pages.Auth.SetNewPasswordModel
@{
    ViewData["Title"] = "Set New Password";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="auth-card-header">
    <h4>Set New Password</h4>
    <p>Choose a new password for your staff account</p>
</div>

<form method="post">
    <input type="hidden" asp-for="Email" />
    <div class="mb-3">
        <label for="Password" class="form-label small fw-semibold">New Password</label>
        <input asp-for="Password" class="form-control" id="Password" placeholder="Enter new password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="ConfirmPassword" class="form-label small fw-semibold">Confirm Password</label>
        <input asp-for="ConfirmPassword" class="form-control" id="ConfirmPassword" placeholder="Confirm new password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-auth-primary w-100 py-2">Set Password</button>
    <div class="text-center mt-3">
        <a asp-page="/Auth/Login" class="auth-link">
            <i class="bi bi-arrow-left"></i> Back to Login
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
