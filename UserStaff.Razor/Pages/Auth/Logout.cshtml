@page
@model Staff.Razor.Pages.Auth.LogoutModel
@{
    ViewData["Title"] = "Logout";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="auth-card-header">
    <h4>Log Out</h4>
    <p>Are you sure you want to end your session?</p>
</div>

<form method="post" class="d-grid gap-2">
    <button type="submit" class="btn btn-auth-primary py-2">Yes, Log Out</button>
    <a asp-page="/Index" class="btn btn-outline-secondary py-2">Cancel</a>
</form>
