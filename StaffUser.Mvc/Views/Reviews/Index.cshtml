@model List<BLL.DTOs.ProductReview.ProductReviewDto>
@{
    ViewData["Title"] = "Product Reviews";
    var productId = ViewBag.ProductId as int?;
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalReviews = ViewBag.TotalReviews as int? ?? 0;
    var allProducts = ViewBag.AllProducts as List<BLL.DTOs.Product.Customer.ProductCustomerDto> ?? new List<BLL.DTOs.Product.Customer.ProductCustomerDto>();
    var currentUserEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
}

<!-- Custom Styles for Reviews Page -->
<link rel="stylesheet" href="~/css/reviews.css" asp-append-version="true" />

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                    @if (productId.HasValue && ViewBag.Product != null)
                    {
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Products</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewBag.Product.ProductName</li>
                    }
                    else
                    {
                        <li class="breadcrumb-item active" aria-current="page">All Reviews</li>
                    }
                </ol>
            </nav>

            <!-- Product Selector (when not viewing specific product) -->
            @if (!productId.HasValue)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex flex-column flex-md-row gap-3 align-items-md-center justify-content-between">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">Select a Product</h5>
                                <p class="text-muted mb-0">Choose a product to view its reviews</p>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <select id="productSelector" class="form-select" style="min-width: 300px;" onchange="window.location.href = this.value;">
                                    <option value="@Url.Action("Index", "Reviews")" selected>-- All Reviews --</option>
                                    @foreach (var p in allProducts)
                                    {
                                        <option value="@Url.Action("Index", "Reviews", new { productId = p.ProductId })">@p.ProductName (@p.Brand)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    @if (productId.HasValue && ViewBag.Product != null)
                    {
                        <h1 class="fw-bold text-dark m-0">@ViewBag.Product.ProductName</h1>
                        <p class="text-muted m-0">Customer Reviews</p>
                    }
                    else
                    {
                        <h1 class="fw-bold text-dark m-0">All Reviews</h1>
                        <p class="text-muted m-0">Browse all product reviews</p>
                    }
                </div>
                @if (productId.HasValue && ViewBag.Product != null)
                {
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Products
                    </a>
                }
            </div>

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-info-circle me-2"></i> @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Review Stats -->
            @if (productId.HasValue && ViewBag.Product != null)
            {
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm p-3 bg-white d-flex flex-row align-items-center justify-content-between" style="border-radius: 12px; border-left: 4px solid #d70018 !important;">
                            <div>
                                <h6 class="text-muted text-uppercase mb-1 fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Reviews</h6>
                                <h3 class="fw-bold text-dark m-0">@totalReviews</h3>
                            </div>
                            <div class="bg-danger-subtle text-danger rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #ffe3e3;">
                                <i class="fs-4">💬</i>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm p-3 bg-white d-flex flex-row align-items-center justify-content-between" style="border-radius: 12px; border-left: 4px solid #ff922b !important;">
                            <div>
                                <h6 class="text-muted text-uppercase mb-1 fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Average Rating</h6>
                                <h3 class="fw-bold text-dark m-0">@(Model.Any() ? Model.Average(r => r.Rating).ToString("0.0") : "0.0")</h3>
                            </div>
                            <div class="bg-warning-subtle text-warning rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #fff5e6;">
                                <i class="fs-4">⭐</i>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm p-3 bg-white d-flex flex-row align-items-center justify-content-between" style="border-radius: 12px; border-left: 4px solid #2b8a3e !important;">
                            <div>
                                <h6 class="text-muted text-uppercase mb-1 fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">5-Star Reviews</h6>
                                <h3 class="fw-bold text-dark m-0">@Model.Count(r => r.Rating == 5)</h3>
                            </div>
                            <div class="bg-success-subtle text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #e6fcf5;">
                                <i class="fs-4">⭐</i>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Reviews List -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    @if (Model.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-chat-square-text text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3 mb-0">No reviews yet. Be the first to review!</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var review in Model)
                            {
                                <div class="list-group-item border-bottom px-4 py-4">
                                    <div class="d-flex flex-column flex-md-row gap-3">
                                        <div class="flex-shrink-0">
                                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                <span class="fw-bold text-secondary">@review.CustomerName.Substring(0, 1).ToUpper()</span>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-1">@review.CustomerName</h6>
                                                    <div class="text-warning mb-1">
                                                        @for (int i = 1; i <= review.Rating; i++)
                                                        {
                                                            <i class="bi bi-star-fill"></i>
                                                        }
                                                        @for (int i = review.Rating + 1; i <= 5; i++)
                                                        {
                                                            <i class="bi bi-star"></i>
                                                        }
                                                    </div>
                                                    <small class="text-muted">@review.CreatedAt.ToString("MMMM dd, yyyy")</small>
                                                </div>
                                                @if (User.Identity!.IsAuthenticated && currentUserEmail == review.CustomerEmail)
                                                {
                                                    <a href="@Url.Action("Edit", "Reviews", new { id = review.Id })" class="btn btn-sm btn-outline-primary ms-2">
                                                        <i class="bi bi-pencil me-1"></i> Edit
                                                    </a>
                                                }
                                            </div>
                                            <p class="text-dark mt-2 mb-0">@review.Comment</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        @if (totalPages > 1)
                        {
                            <nav aria-label="Reviews pagination" class="px-4 py-3">
                                <ul class="pagination justify-content-center mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", "Reviews", new { productId = productId, page = currentPage - 1 })" aria-label="Previous">
                                            <span aria-hidden="true">&laquo;</span>
                                        </a>
                                    </li>
                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                                        {
                                            <li class="page-item @(i == currentPage ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("Index", "Reviews", new { productId = productId, page = i })">@i</a>
                                            </li>
                                        }
                                        else if (i == currentPage - 2 || i == currentPage + 2)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                    }
                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", "Reviews", new { productId = productId, page = currentPage + 1 })" aria-label="Next">
                                            <span aria-hidden="true">&raquo;</span>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>