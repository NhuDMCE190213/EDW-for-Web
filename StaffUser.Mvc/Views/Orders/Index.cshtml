@model Customer.Mvc.Models.MyOrdersViewModel
@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string GetStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "pending" => "bg-warning-subtle text-warning",
            "processing" => "bg-info-subtle text-info",
            "confirmed" => "bg-primary-subtle text-primary",
            "shipped" => "bg-secondary-subtle text-secondary",
            "completed" => "bg-success-subtle text-success",
            "cancelled" => "bg-danger-subtle text-danger",
            _ => "bg-secondary-subtle text-secondary"
        };
    }
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="section-title">
            My Orders
        </h4>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
            <div class="card-header border-0 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 py-3 px-4"
                 style="background-color: var(--color-primary); color: #ffffff;">
                <div>
                    <h5 class="mb-1 fw-bold">Order History</h5>
                    <div class="small" style="opacity: .85;">@Model.CustomerName</div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge px-3 py-2" style="background-color: rgba(255,255,255,0.18); border-radius: 999px; font-weight: 600;">
                        @Model.TotalOrders orders
                    </span>
                    <span class="badge px-3 py-2" style="background-color: rgba(255,255,255,0.18); border-radius: 999px; font-weight: 600;">
                        Total spent: @Model.TotalSpent.ToString("N0")
                    </span>
                </div>
            </div>
            <div class="card-body p-0">
                @if (!Model.Orders.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-bag text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 mb-2 fw-bold text-dark">You have no orders yet</h5>
                        <p class="text-muted mb-4">Your completed purchases will appear here once you place your first order.</p>
                        <a asp-controller="Home" asp-action="Index" class="btn text-white border-0 px-4 py-2 fw-semibold"
                           style="background-color: var(--color-primary); border-radius: 8px;">
                            Start shopping
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Order</th>
                                    <th scope="col">Date</th>
                                    <th scope="col">Items</th>
                                    <th scope="col">Total</th>
                                    <th scope="col" class="pe-4">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.Orders)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-semibold text-dark">@order.OrderId</div>
                                            <div class="text-muted small">Customer #@order.CustomerId</div>
                                        </td>
                                        <td>
                                            <div>@order.CreatedAt.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted small">@order.CreatedAt.ToString("HH:mm")</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border" style="border-radius: 999px;">@order.OrderItems.Count item(s)</span>
                                        </td>
                                        <td class="fw-semibold" style="color: var(--color-primary);">@order.TotalAmount.ToString("N0")</td>
                                        <td class="pe-4">
                                            <span class="badge @GetStatusClass(order.Status) px-3 py-2" style="border-radius: 999px; font-weight: 600;">@order.Status</span>
                                        </td>
                                    </tr>
                                    <tr class="table-light">
                                        <td colspan="5" class="p-0">
                                            <div class="accordion accordion-flush" id="order-@order.OrderId.ToString("N")">
                                                <div class="accordion-item border-0">
                                                    <h2 class="accordion-header">
                                                        <button class="accordion-button collapsed bg-transparent shadow-none py-3 px-4" type="button" data-bs-toggle="collapse" data-bs-target="#details-@order.OrderId.ToString("N")" aria-expanded="false" aria-controls="details-@order.OrderId.ToString("N")">
                                                            View order items
                                                        </button>
                                                    </h2>
                                                    <div id="details-@order.OrderId.ToString("N")" class="accordion-collapse collapse" data-bs-parent="#order-@order.OrderId.ToString("N")">
                                                        <div class="accordion-body pt-0 px-4">
                                                            <div class="table-responsive">
                                                                <table class="table table-sm mb-0">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Product</th>
                                                                            <th>Variant</th>
                                                                            <th class="text-end">Qty</th>
                                                                            <th class="text-end">Price</th>
                                                                            <th class="text-end">Subtotal</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var item in order.OrderItems)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    <div class="fw-semibold">@item.ProductName</div>
                                                                                    <div class="text-muted small">Item #@item.OrderItemId</div>
                                                                                </td>
                                                                                <td class="text-muted">@item.ProductVariantDetails</td>
                                                                                <td class="text-end">@item.Quantity</td>
                                                                                <td class="text-end">@item.PriceAtPurchase.ToString("N0")</td>
                                                                                <td class="text-end fw-semibold">@item.Subtotal.ToString("N0")</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>