@model BLL.DTOs.Auth.LoginDto
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card-header">
    <h4>Welcome Back</h4>
    <p>Sign in to track orders and manage your account</p>
</div>

<form asp-action="Login" asp-controller="Auth" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
    <div class="mb-3">
        <label for="Email" class="form-label small fw-semibold">Email</label>
        <input asp-for="Email" class="form-control" id="Email" placeholder="Enter your email" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label for="Password" class="form-label small fw-semibold">Password</label>
        <input asp-for="Password" class="form-control" type="password" id="Password" placeholder="Enter your password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="RememberMe" class="form-check-input" id="RememberMe" />
        <label class="form-check-label small" for="RememberMe">Remember me</label>
    </div>
    <button type="submit" class="btn btn-auth-primary w-100 py-2">Sign In</button>
    <div class="text-center mt-3 d-flex justify-content-between">
        <a asp-action="ForgotPassword" asp-controller="Auth" class="auth-link">Forgot Password?</a>
        <a asp-action="Register" asp-controller="Auth" class="auth-link">Create account</a>
    </div>
</form>
