@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card-header">
    <h4>Forgot Password</h4>
    <p>Enter your email to reset your account password</p>
</div>

<form asp-action="ForgotPassword" asp-controller="Auth" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
    <div class="mb-3">
        <label for="email" class="form-label small fw-semibold">Email</label>
        <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email" required />
    </div>
    <button type="submit" class="btn btn-auth-primary w-100 py-2">Reset Password</button>
    <div class="text-center mt-3">
        <a asp-action="Login" asp-controller="Auth" class="auth-link">
            <i class="bi bi-arrow-left"></i> Back to Login
        </a>
    </div>
</form>
