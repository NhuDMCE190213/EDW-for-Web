@using System.Globalization
@model List<BLL.DTOs.CartItem.CartItemDTO>
@{
    ViewData["Title"] = "My Cart";
}
@section Styles {
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}

<div class="row">
    <div class="col-12">
        <h2 class="fw-bold text-dark mb-4"><i class="bi bi-cart3 me-2 text-danger"></i>Shopping Cart</h2>
    </div>

    @if (TempData["CheckoutError"] != null)
    {
        <div class="col-12">
            <div class="alert alert-danger border-0 shadow-sm" role="alert">
                @TempData["CheckoutError"]
            </div>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="col-12">
            <div class="text-center py-5 bg-white border rounded shadow-sm">
                <i class="bi bi-cart-x text-muted mb-3" style="font-size: 4rem; display: block;"></i>
                <h4 class="fw-bold text-dark">Your Cart is Empty</h4>
                <p class="text-muted">You haven't added any products to your cart yet.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-danger px-4 py-2 mt-2 text-white border-0" style="background-color: var(--color-primary); border-radius: 8px;">Shop Now</a>
            </div>
        </div>
    }
    else
    {
        <div class="col-lg-8">
            <div class="cart-card">
                <div class="d-flex justify-content-between align-items-center pb-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <input type="checkbox" id="selectAllCheckbox" class="cart-item-checkbox" checked onchange="toggleSelectAll(this)" />
                        <label for="selectAllCheckbox" class="fw-semibold text-dark mb-0 cursor-pointer">Select All (@Model.Count items)</label>
                    </div>
                </div>

                <form id="checkoutForm" action="@Url.Action("Checkout", "Order")" method="post">
                    @Html.AntiForgeryToken()
                    @foreach (var item in Model)
                    {
                        var variant = item.ProductVariant;
                        if (variant == null) continue;

                        // Xử lý chuỗi thông số kỹ thuật (Specs) từ dữ liệu DTO
                        var specsList = new List<string>();
                        if (!string.IsNullOrEmpty(variant.Cpu)) specsList.Add(variant.Cpu);
                        if (!string.IsNullOrEmpty(variant.Ram)) specsList.Add(variant.Ram + " RAM");
                        if (!string.IsNullOrEmpty(variant.Storage)) specsList.Add(variant.Storage);
                        if (!string.IsNullOrEmpty(variant.ScreenSize)) specsList.Add(variant.ScreenSize + " Screen");

                        var specsLabel = specsList.Any() ? string.Join(", ", specsList) : "Standard Model";

                        <div class="cart-item-row" id="row-@item.CartItemId">
                            <div class="pe-3">
                                @* Form checkout sẽ gửi danh sách CartItemId được chọn lên Server *@
                                <input type="checkbox" name="selectedCartItemIds" value="@item.CartItemId" class="cart-item-checkbox item-select-check" checked data-price="@variant.GetPrice()" data-qty="@item.Quantity" onchange="calculateSummary()" />
                            </div>
                            <div class="d-flex align-items-center gap-3 flex-grow-1">
                                <img src="/@(variant.ImageUrl ?? "uploads/placeholder.png")" class="cart-item-img" alt="product thumbnail" />
                                <div class="flex-grow-1">
                                    <span class="product-brand" style="font-size: 0.72rem; font-weight: 600; text-transform: uppercase; color: #888888;">@variant.Brand</span>
                                    <h6 class="fw-bold text-dark mb-1">@variant.ProductName</h6>
                                    <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.72rem; font-weight: 500;">
                                        @variant.Color / @specsLabel
                                    </span>
                                </div>
                            </div>

                            <div class="text-end px-3">
                                <span class="fw-bold text-danger fs-5" id="price-@item.CartItemId">@((variant.GetPrice() * item.Quantity).ToString("C"))</span>
                                <div class="text-muted small">
                                    @variant.GetPrice().ToString("N0", new CultureInfo("vi-VN")) each
                                    @if (variant.GetPrice() < variant.Price)
                                    {
                                        <span class="text-decoration-line-through ms-1" style="opacity:.6;">@variant.Price.ToString("N0", new CultureInfo("vi-VN"))</span>
                                    }
                                </div>
                            </div>

                            <div class="px-2">
                                <div class="qty-control">
                                    <button type="button" class="qty-btn" onclick="adjustQty('@item.CartItemId', -1)">-</button>
                                    <input type="number" class="qty-input" id="qty-@item.CartItemId" value="@item.Quantity" min="1" max="@variant.StockQuantity" onchange="updateQtyDirect('@item.CartItemId', this.value)" />
                                    <button type="button" class="qty-btn" onclick="adjustQty('@item.CartItemId', 1)">+</button>
                                </div>
                            </div>

                            <div class="ps-3">
                                <button type="button" class="remove-btn" onclick="removeCartItem('@item.CartItemId')" title="Remove item">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </div>
                        </div>
                    }
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="summary-card">
                <h5 class="fw-bold text-dark mb-4">Order Summary</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Total items selected:</span>
                    <span class="fw-semibold text-dark" id="summary-items">0</span>
                </div>
                <div class="d-flex justify-content-between mb-4">
                    <span class="text-muted">Subtotal:</span>
                    <span class="fw-bold text-danger fs-4" id="summary-total">00 đ</span>
                </div>

                <div class="alert alert-warning border-0 small mb-4 bg-warning-subtle text-warning-emphasis">
                    <i class="bi bi-info-circle-fill me-1"></i> Check out process requires login verification.
                </div>

                <button type="button" class="btn btn-danger w-100 py-2.5 fw-bold text-white border-0" style="background-color: var(--color-primary); border-radius: 8px;" onclick="submitCheckout()">
                    Checkout <i class="bi bi-arrow-right-short fs-5 align-middle"></i>
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            calculateSummary();
        });

        function toggleSelectAll(master) {
            $(".item-select-check").prop("checked", master.checked);
            calculateSummary();
        }

        function calculateSummary() {
            let totalCount = 0;
            let totalAmount = 0;
            let allChecked = true;

            const checks = $(".item-select-check");
            if (checks.length === 0) {
                return;
            }

            checks.each(function() {
                if (this.checked) {
                    const price = parseFloat($(this).data("price"));
                    const qty = parseInt($(this).data("qty"));
                    totalCount += qty;
                    totalAmount += price * qty;
                } else {
                    allChecked = false;
                }
            });

            $("#selectAllCheckbox").prop("checked", allChecked && checks.length > 0);
            $("#summary-items").text(totalCount);

            const formatter = new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            });
            $("#summary-total").text(formatter.format(totalAmount));
        }

        function adjustQty(cartItemId, change) {
            const input = $("#qty-" + cartItemId);
            let current = parseInt(input.val()) || 1;
            let target = current + change;
            const max = parseInt(input.attr("max")) || 999;

            if (target < 1) target = 1;
            if (target > max) {
                showToast("Only " + max + " units are available in stock.", "info", "Stock Limit");
                target = max;
            }

            input.val(target);
            updateCartQuantityOnServer(cartItemId, target);
        }

        function updateQtyDirect(cartItemId, value) {
            let qty = parseInt(value) || 1;
            const input = $("#qty-" + cartItemId);
            const max = parseInt(input.attr("max")) || 999;

            if (qty < 1) qty = 1;
            if (qty > max) {
                showToast("Only " + max + " units are available in stock.", "info", "Stock Limit");
                qty = max;
            }

            input.val(qty);
            updateCartQuantityOnServer(cartItemId, qty);
        }

        function updateCartQuantityOnServer(cartItemId, quantity) {
            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Cart")',
                type: 'POST',
                data: { cartItemId: cartItemId, quantity: quantity },
                success: function(response) {
                    if (response.success) {
                        $("#cart-count").text(response.totalCount);

                        const formatter = new Intl.NumberFormat('en-US', {
                            style: 'currency',
                            currency: 'USD',
                        });
                        $("#price-" + cartItemId).text(formatter.format(response.totalPrice));

                        // Cập nhật lại thuộc tính dữ liệu (data-qty) trên thẻ checkbox
                        const checkbox = $("input[value='" + cartItemId + "'].item-select-check");
                        checkbox.data("qty", quantity);

                        calculateSummary();

                        if (response.warning) {
                            showToast(response.warning, "info", "Promotion Warning");
                        }
                    } else {
                        showToast(response.message, "error", "Update Failed");
                        setTimeout(() => window.location.reload(), 1500);
                    }
                },
                error: function() {
                    showToast("Error communicating with cart service.", "error", "Connection Error");
                }
            });
        }

        function removeCartItem(cartItemId) {
            if (!confirm("Are you sure you want to remove this item from the cart?")) {
                return;
            }

            $.ajax({
                url: '@Url.Action("Remove", "Cart")',
                type: 'POST',
                data: { cartItemId: cartItemId },
                success: function(response) {
                    if (response.success) {
                        $("#row-" + cartItemId).fadeOut(400, function() {
                            $(this).remove();
                            $("#cart-count").text(response.totalCount);

                            if (response.totalCount === 0) {
                                window.location.reload();
                            } else {
                                calculateSummary();
                            }
                        });
                    }
                },
                error: function() {
                    showToast("Error removing item.", "error", "Remove Failed");
                }
            });
        }

        function submitCheckout() {
            const ticked = $(".item-select-check:checked");
            if (ticked.length === 0) {
                showToast("Please select at least one item to proceed to order.", "info", "No Items Selected");
                return;
            }
            document.getElementById('checkoutForm').submit();
        }
    </script>
}