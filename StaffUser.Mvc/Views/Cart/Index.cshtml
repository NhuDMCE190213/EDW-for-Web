@using System.Globalization
@model List<BLL.DTOs.CartItem.CartItemDTO>
@{
    ViewData["Title"] = "My Cart";
}
@section Styles {
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
    <style>
        /* ── Remove confirm modal ── */
        .remove-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 1080;
            align-items: center;
            justify-content: center;
        }
        .remove-modal-overlay.show { display: flex; }
        .remove-modal-box {
            background: #fff;
            border-radius: 16px;
            padding: 32px 28px;
            max-width: 420px;
            width: 90%;
            box-shadow: 0 20px 60px rgba(0,0,0,.2);
            animation: slideUp .2s ease;
        }
        @@keyframes slideUp {
            from { transform: translateY(24px); opacity: 0; }
            to   { transform: translateY(0);    opacity: 1; }
        }
        .remove-modal-icon {
            width: 56px; height: 56px;
            background: #fff3f3;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px;
        }
        .remove-modal-icon i { font-size: 1.6rem; color: #d63031; }
        .btn-confirm-remove {
            background: #d63031; color: #fff; border: none;
            border-radius: 8px; padding: 10px 24px; font-weight: 600;
            transition: background .15s;
        }
        .btn-confirm-remove:hover { background: #c0392b; }
        .btn-keep {
            background: #f5f5f5; color: #444; border: none;
            border-radius: 8px; padding: 10px 24px; font-weight: 600;
        }
        .btn-keep:hover { background: #eaeaea; }
    </style>
}

@* ─── Remove-product confirm modal ─────────────────────────────────────── *@
<div class="remove-modal-overlay" id="removeModal" role="dialog" aria-modal="true">
    <div class="remove-modal-box text-center">
        <div class="remove-modal-icon">
            <i class="bi bi-trash3-fill"></i>
        </div>
        <h5 class="fw-bold mb-1">Remove Product?</h5>
        <p class="text-muted mb-4" id="removeModalProductName" style="font-size:.9rem;">
            Are you sure you want to remove this item from your cart?
        </p>
        <div class="d-flex gap-3 justify-content-center">
            <button type="button" class="btn btn-keep" onclick="closeRemoveModal()">
                <i class="bi bi-x-lg me-1"></i> Keep It
            </button>
            <button type="button" class="btn btn-confirm-remove" id="confirmRemoveBtn">
                <i class="bi bi-trash3 me-1"></i> Remove
            </button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <h2 class="fw-bold text-dark mb-4"><i class="bi bi-cart3 me-2 text-danger"></i>Shopping Cart</h2>
    </div>

    @if (TempData["CheckoutError"] != null)
    {
        <div class="col-12">
            <div class="alert alert-danger border-0 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["CheckoutError"]
            </div>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="col-12">
            <div class="text-center py-5 bg-white border rounded-4 shadow-sm">
                <i class="bi bi-cart-x text-muted mb-3" style="font-size: 4rem; display: block;"></i>
                <h4 class="fw-bold text-dark">Your Cart is Empty</h4>
                <p class="text-muted">You haven't added any products to your cart yet.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-danger px-4 py-2 mt-2 text-white border-0"
                   style="background-color: var(--color-primary); border-radius: 8px;">
                    <i class="bi bi-bag-heart me-1"></i> Shop Now
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="col-lg-8">
            <div class="cart-card">
                <div class="d-flex justify-content-between align-items-center pb-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <input type="checkbox" id="selectAllCheckbox" class="cart-item-checkbox"
                               checked onchange="toggleSelectAll(this)" />
                        <label for="selectAllCheckbox" class="fw-semibold text-dark mb-0" style="cursor:pointer;">
                            Select All (@Model.Count item(s))
                        </label>
                    </div>
                    <span class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i>Prices include any active promotions
                    </span>
                </div>

                <form id="checkoutForm" action="@Url.Action("Checkout", "Order")" method="post">
                    @Html.AntiForgeryToken()
                    @foreach (var item in Model)
                    {
                        var variant = item.ProductVariant;
                        if (variant == null) continue;

                        var specsList = new List<string>();
                        if (!string.IsNullOrEmpty(variant.Cpu))        specsList.Add(variant.Cpu);
                        if (!string.IsNullOrEmpty(variant.Ram))        specsList.Add(variant.Ram + " RAM");
                        if (!string.IsNullOrEmpty(variant.Storage))    specsList.Add(variant.Storage);
                        if (!string.IsNullOrEmpty(variant.ScreenSize)) specsList.Add(variant.ScreenSize + " Screen");
                        var specsLabel = specsList.Any() ? string.Join(", ", specsList) : "Standard Model";

                        <div class="cart-item-row" id="row-@item.CartItemId">
                            <div class="pe-3">
                                <input type="checkbox"
                                       name="selectedCartItemIds"
                                       value="@item.CartItemId"
                                       class="cart-item-checkbox item-select-check"
                                       checked
                                       data-price="@variant.GetPrice()"
                                       data-qty="@item.Quantity"
                                       onchange="calculateSummary()" />
                            </div>
                            <div class="d-flex align-items-center gap-3 flex-grow-1">
                                <img src="/@(variant.ImageUrl ?? "uploads/placeholder.png")"
                                     class="cart-item-img" alt="@variant.ProductName" />
                                <div class="flex-grow-1">
                                    <span class="product-brand" style="font-size:.72rem; font-weight:600; text-transform:uppercase; color:#888;">
                                        @variant.Brand
                                    </span>
                                    <h6 class="fw-bold text-dark mb-1">@variant.ProductName</h6>
                                    <span class="badge bg-light text-secondary border px-2 py-1" style="font-size:.72rem; font-weight:500;">
                                        @variant.Color / @specsLabel
                                    </span>
                                </div>
                            </div>

                            <div class="text-end px-3">
                                <span class="fw-bold text-danger fs-5" id="price-@item.CartItemId">
                                    @((variant.GetPrice() * item.Quantity).ToString("C"))
                                </span>
                                <div class="text-muted small">
                                    @variant.GetPrice().ToString("N0", new CultureInfo("vi-VN")) ₫ each
                                    @if (variant.GetPrice() < variant.Price)
                                    {
                                        <span class="text-decoration-line-through ms-1" style="opacity:.6;">
                                            @variant.Price.ToString("N0", new CultureInfo("vi-VN"))
                                        </span>
                                        <span class="badge bg-danger text-white ms-1" style="font-size:.65rem;">SALE</span>
                                    }
                                </div>
                            </div>

                            <div class="px-2">
                                <div class="qty-control">
                                    <button type="button" class="qty-btn" onclick="adjustQty('@item.CartItemId', -1)">-</button>
                                    <input type="number" class="qty-input"
                                           id="qty-@item.CartItemId"
                                           value="@item.Quantity"
                                           min="1" max="@variant.StockQuantity"
                                           onchange="updateQtyDirect('@item.CartItemId', this.value)" />
                                    <button type="button" class="qty-btn" onclick="adjustQty('@item.CartItemId', 1)">+</button>
                                </div>
                            </div>

                            <div class="ps-3">
                                <button type="button"
                                        class="remove-btn"
                                        onclick="openRemoveModal('@item.CartItemId', '@Html.Raw(variant.ProductName?.Replace("'","\\'")??"Product")')"
                                        title="Remove from cart">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </div>
                        </div>
                    }
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="summary-card">
                <h5 class="fw-bold text-dark mb-4">Order Summary</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Items selected:</span>
                    <span class="fw-semibold text-dark" id="summary-items">0</span>
                </div>
                <div class="d-flex justify-content-between mb-4">
                    <span class="text-muted">Subtotal:</span>
                    <span class="fw-bold text-danger fs-4" id="summary-total">0 ₫</span>
                </div>

                <div class="alert alert-info border-0 small mb-3 bg-info-subtle text-info-emphasis">
                    <i class="bi bi-truck me-1"></i> Free shipping on all orders.
                </div>
                <div class="alert alert-warning border-0 small mb-4 bg-warning-subtle text-warning-emphasis">
                    <i class="bi bi-info-circle-fill me-1"></i> Login required to complete checkout.
                </div>

                <button type="button"
                        class="btn w-100 fw-bold text-white border-0 mb-2"
                        style="background-color: var(--color-primary); border-radius: 8px; padding: 12px;"
                        onclick="submitCheckout()">
                    Checkout <i class="bi bi-arrow-right-short fs-5 align-middle"></i>
                </button>
                <a href="@Url.Action("Index", "Orders")" class="btn w-100 btn-outline-secondary" style="border-radius:8px;">
                    <i class="bi bi-bag-check me-1"></i> View My Orders
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // ── Init ─────────────────────────────────────────────────────────────
        $(document).ready(function () {
            calculateSummary();
        });

        // ── Select All ────────────────────────────────────────────────────────
        function toggleSelectAll(master) {
            $(".item-select-check").prop("checked", master.checked);
            calculateSummary();
        }

        // ── Summary calculator ────────────────────────────────────────────────
        function calculateSummary() {
            let totalCount = 0, totalAmount = 0, allChecked = true;
            const checks = $(".item-select-check");
            if (checks.length === 0) return;

            checks.each(function () {
                if (this.checked) {
                    totalCount  += parseInt($(this).data("qty"));
                    totalAmount += parseFloat($(this).data("price")) * parseInt($(this).data("qty"));
                } else {
                    allChecked = false;
                }
            });

            $("#selectAllCheckbox").prop("checked", allChecked && checks.length > 0);
            $("#summary-items").text(totalCount);

            const fmt = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });
            $("#summary-total").text(fmt.format(totalAmount));
        }

        // ── Qty controls ──────────────────────────────────────────────────────
        function adjustQty(cartItemId, change) {
            const input = $("#qty-" + cartItemId);
            let current = parseInt(input.val()) || 1;
            let target  = current + change;
            const max   = parseInt(input.attr("max")) || 999;

            if (target < 1) target = 1;
            if (target > max) {
                showToast("Only " + max + " units available in stock.", "info", "Stock Limit");
                target = max;
            }
            input.val(target);
            updateCartQuantityOnServer(cartItemId, target);
        }

        function updateQtyDirect(cartItemId, value) {
            let qty   = parseInt(value) || 1;
            const input = $("#qty-" + cartItemId);
            const max   = parseInt(input.attr("max")) || 999;
            if (qty < 1) qty = 1;
            if (qty > max) {
                showToast("Only " + max + " units available in stock.", "info", "Stock Limit");
                qty = max;
            }
            input.val(qty);
            updateCartQuantityOnServer(cartItemId, qty);
        }

        function updateCartQuantityOnServer(cartItemId, quantity) {
            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Cart")',
                type: 'POST',
                data: { cartItemId, quantity },
                success: function (response) {
                    if (response.success) {
                        $("#cart-count").text(response.totalCount);

                        const fmt = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });
                        $("#price-" + cartItemId).text(fmt.format(response.totalPrice));

                        $("input[value='" + cartItemId + "'].item-select-check").data("qty", quantity);
                        calculateSummary();

                        if (response.warning) showToast(response.warning, "info", "Promotion Notice");
                    } else {
                        showToast(response.message, "error", "Update Failed");
                        setTimeout(() => window.location.reload(), 1500);
                    }
                },
                error: function () {
                    showToast("Connection error. Could not update quantity.", "error", "Error");
                }
            });
        }

        // ── Remove Product (with custom modal) ───────────────────────────────
        let _pendingRemoveId = null;

        function openRemoveModal(cartItemId, productName) {
            _pendingRemoveId = cartItemId;
            document.getElementById('removeModalProductName').textContent =
                'Remove "' + productName + '" from your cart?';
            document.getElementById('removeModal').classList.add('show');

            // Wire confirm button
            document.getElementById('confirmRemoveBtn').onclick = function () {
                closeRemoveModal();
                doRemoveCartItem(_pendingRemoveId);
            };
        }

        function closeRemoveModal() {
            document.getElementById('removeModal').classList.remove('show');
            _pendingRemoveId = null;
        }

        // Close when clicking backdrop
        document.getElementById('removeModal').addEventListener('click', function (e) {
            if (e.target === this) closeRemoveModal();
        });

        function doRemoveCartItem(cartItemId) {
            const btn = document.querySelector('#row-' + cartItemId + ' .remove-btn');
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>'; }

            $.ajax({
                url: '@Url.Action("Remove", "Cart")',
                type: 'POST',
                data: { cartItemId: cartItemId },
                success: function (response) {
                    if (response.success) {
                        $("#row-" + cartItemId).fadeOut(350, function () {
                            $(this).remove();
                            $("#cart-count").text(response.totalCount);
                            if ($(".item-select-check").length === 0) {
                                window.location.reload();
                            } else {
                                calculateSummary();
                                showToast("Item removed from cart.", "success", "Removed");
                            }
                        });
                    } else {
                        showToast(response.message || "Could not remove item.", "error", "Error");
                        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-trash3-fill"></i>'; }
                    }
                },
                error: function () {
                    showToast("Connection error. Could not remove item.", "error", "Error");
                    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-trash3-fill"></i>'; }
                }
            });
        }

        // ── Checkout ──────────────────────────────────────────────────────────
        function submitCheckout() {
            const ticked = $(".item-select-check:checked");
            if (ticked.length === 0) {
                showToast("Please select at least one item to proceed.", "info", "No Items Selected");
                return;
            }
            document.getElementById('checkoutForm').submit();
        }
    </script>
}