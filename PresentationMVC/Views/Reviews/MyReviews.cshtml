@model PresentationMVC.Models.Review.MyReviewsViewModel
@{
    ViewData["Title"] = "My Reviews";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="py-4">
    <!-- Hero Banner -->
    <div class="customer-hero mb-4">
        <span class="badge bg-warning text-dark mb-2"><i class="bi bi-star-fill me-1"></i>MY FEEDBACK</span>
        <h1 class="display-6 fw-bold">My Product Reviews</h1>
        <p class="mb-0">Manage the reviews and ratings you have shared for products you purchased.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm mb-4 rounded-4">
        <div class="card-body p-3">
            <form method="get" asp-action="MyReviews" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Search by product name or review text..." value="@Model.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="rating" class="form-select">
                        <option value="">All Ratings</option>
                        <option value="5" selected="@(Model.FilterRating == 5)">5 Stars ★★★★★</option>
                        <option value="4" selected="@(Model.FilterRating == 4)">4 Stars ★★★★☆</option>
                        <option value="3" selected="@(Model.FilterRating == 3)">3 Stars ★★★☆☆</option>
                        <option value="2" selected="@(Model.FilterRating == 2)">2 Stars ★★☆☆☆</option>
                        <option value="1" selected="@(Model.FilterRating == 1)">1 Star ★☆☆☆☆</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="status" class="form-select">
                        <option value="">All Status</option>
                        <option value="Published" selected="@(Model.FilterStatus == "Published")">Published</option>
                        <option value="Pending" selected="@(Model.FilterStatus == "Pending")">Pending</option>
                        <option value="Hidden" selected="@(Model.FilterStatus == "Hidden")">Hidden</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-danger w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a asp-action="MyReviews" class="btn btn-outline-secondary" title="Clear filter"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Review Cards -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Submitted Reviews <span class="badge bg-secondary-subtle text-secondary rounded-pill ms-1">@Model.TotalReviews</span></h5>
        <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-bag-check me-1"></i>Check Completed Orders to Review
        </a>
    </div>

    @if (Model.Reviews.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 my-3">
            <div class="card-body">
                <i class="bi bi-chat-heart text-danger display-3 d-block mb-3"></i>
                <h4 class="fw-bold text-dark">No reviews found</h4>
                <p class="text-muted">You have not submitted any reviews matching this criteria.</p>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-danger px-4 rounded-pill mt-2">
                    <i class="bi bi-bag-check me-1"></i>View My Orders to Review
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            @foreach (var review in Model.Reviews)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 position-relative d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark">@review.ProductName</h5>
                                    <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <div>
                                    @if (review.Status == "Published")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Published
                                        </span>
                                    }
                                    else if (review.Status == "Hidden" || review.IsLockedByAdmin)
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">
                                            <i class="bi bi-lock-fill me-1"></i>Locked / Hidden
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i>Under Review
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Star Rating -->
                            <div class="mb-2 text-warning fs-5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Rating)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-secondary opacity-25"></i>
                                    }
                                }
                                <span class="text-muted small ms-1 fw-bold fs-6">(@review.Rating / 5)</span>
                            </div>

                            <!-- Content -->
                            <p class="text-secondary text-break mb-3" style="line-height: 1.6;">
                                @review.Content
                            </p>
                        </div>

                        <!-- Footer Actions -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                            <span class="text-muted small">
                                @if (review.UpdatedAt.HasValue)
                                {
                                    <i class="bi bi-pencil-fill me-1"></i><span>Edited @review.UpdatedAt.Value.ToString("dd/MM/yyyy")</span>
                                }
                            </span>
                            <div>
                                @if (review.CanEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@review.ReviewId" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-pencil-square me-1"></i>Edit Review
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-3 py-2 rounded-pill" title="This review has been locked by moderation and cannot be edited">
                                        <i class="bi bi-lock-fill me-1"></i>Locked by Admin
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Review pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="MyReviews" asp-route-page="@(Model.CurrentPage - 1)" asp-route-rating="@Model.FilterRating" asp-route-status="@Model.FilterStatus" asp-route-search="@Model.SearchTerm">
                            Previous
                        </a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="MyReviews" asp-route-page="@p" asp-route-rating="@Model.FilterRating" asp-route-status="@Model.FilterStatus" asp-route-search="@Model.SearchTerm">
                                @p
                            </a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="MyReviews" asp-route-page="@(Model.CurrentPage + 1)" asp-route-rating="@Model.FilterRating" asp-route-status="@Model.FilterStatus" asp-route-search="@Model.SearchTerm">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
