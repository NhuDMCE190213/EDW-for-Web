@using System.Globalization
@model PresentationMVC.Models.ProductCustomerModel
@{
    ViewData["Title"] = Model.ProductName;
    var defaultVariant = Model.Variants.FirstOrDefault();
    string initialImg = defaultVariant?.ImageUrl ?? Model.ImageUrl ?? "https://images.unsplash.com/photo-1511707171634-5f897ff02560?w=600&auto=format&fit=crop&q=80";
}

@section Styles {
    <style>
        .product-detail-container {
            max-width: 1100px;
            margin: 20px auto 60px;
        }
        .product-gallery-box {
            background: #fff;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            padding: 30px;
            text-align: center;
            height: 440px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 16px rgba(0,0,0,0.03);
        }
        .variant-pill-btn {
            border: 1.5px solid #cbd5e1;
            background: #fff;
            color: #334155;
            padding: 10px 16px;
            border-radius: 12px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.15s;
            text-align: left;
        }
        .variant-pill-btn:hover {
            border-color: #94a3b8;
            background: #f8fafc;
        }
        .variant-pill-btn.active {
            border-color: var(--customer-primary);
            background: var(--color-primary-light, #fee2e2);
            color: var(--customer-primary-dark);
            font-weight: 700;
        }
    </style>
}

<div class="product-detail-container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Customer" class="text-decoration-none">Store</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Customer" asp-route-category="@Model.CategoryName" class="text-decoration-none">@Model.CategoryName</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
        </ol>
    </nav>

    <div class="row g-5">
        <!-- Product Image Gallery -->
        <div class="col-lg-6">
            <div class="product-gallery-box">
                <img id="detailMainImg" src="@initialImg" alt="@Model.ProductName" class="img-fluid h-100 object-fit-contain" />
            </div>

        </div>

        <!-- Product Details & Variant Picker -->
        <div class="col-lg-6">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-danger-subtle text-danger px-3 py-1 fw-bold">@Model.CategoryName</span>
                <span class="text-muted fw-bold text-uppercase small">@Model.Brand</span>
            </div>

            <h1 class="h3 fw-bold text-dark mb-3">@Model.ProductName</h1>

            <div class="mb-3">
                <span class="display-6 fw-bold text-danger" id="detailPrice">
                    @(defaultVariant != null ? $"{defaultVariant.Price.ToString("N0", new CultureInfo("vi-VN"))} ₫" : "Contact")
                </span>
            </div>

            <div id="detailStockBadge" class="mb-4">
                @if (defaultVariant != null && defaultVariant.StockQuantity > 0)
                {
                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i> In Stock (@defaultVariant.StockQuantity available)
                    </span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-x-circle-fill me-1"></i> Out of Stock
                    </span>
                }
            </div>

            @if (Model.Variants.Count > 0)
            {
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark mb-2">Select Variant / Configuration:</label>
                    <div class="d-flex flex-column gap-2" id="detailVariantsList">
                        @for (int i = 0; i < Model.Variants.Count; i++)
                        {
                            var v = Model.Variants[i];
                            var specs = new List<string>();
                            if (!string.IsNullOrEmpty(v.Cpu)) specs.Add(v.Cpu);
                            if (!string.IsNullOrEmpty(v.Ram)) specs.Add(v.Ram + " RAM");
                            if (!string.IsNullOrEmpty(v.Storage)) specs.Add(v.Storage);
                            if (!string.IsNullOrEmpty(v.ScreenSize)) specs.Add(v.ScreenSize + " Screen");
                            string specsStr = specs.Count > 0 ? string.Join(", ", specs) : "Standard";

                            <button type="button"
                                    class="variant-pill-btn d-flex align-items-center justify-content-between @(i == 0 ? "active" : "")"
                                    onclick="switchDetailVariant('@v.ProductVariantId', '@v.Price', '@v.StockQuantity', '@v.ImageUrl', this)">
                                <div>
                                    <div class="fw-bold">@v.Color</div>
                                    <small class="text-muted">@specsStr</small>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-danger">@v.Price.ToString("N0", new CultureInfo("vi-VN")) ₫</div>
                                    <small class="text-muted">Stock: @v.StockQuantity</small>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Quantity & Add to Cart -->
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="qty-control">
                    <button type="button" class="qty-btn" onclick="adjustDetailQty(-1)">-</button>
                    <input type="number" id="detailQtyInput" class="qty-input" value="1" min="1" max="99" />
                    <button type="button" class="qty-btn" onclick="adjustDetailQty(1)">+</button>
                </div>
                <button type="button" id="btnDetailAddToCart" class="btn btn-danger flex-grow-1 py-3 rounded-3 fw-bold shadow-sm"
                        style="background-color:var(--customer-primary);" onclick="submitDetailAddToCart()">
                    <i class="bi bi-cart-plus me-2 fs-5"></i> Add to Cart
                </button>
            </div>

            <!-- Assurance Perks -->
            <div class="p-3 bg-light rounded-4 border">
                <div class="d-flex align-items-center gap-3 mb-2 small text-muted">
                    <i class="bi bi-truck text-danger fs-5"></i>
                    <span>Free Standard Shipping on all nationwide orders</span>
                </div>
                <div class="d-flex align-items-center gap-3 mb-2 small text-muted">
                    <i class="bi bi-arrow-counterclockwise text-success fs-5"></i>
                    <span>7-day easy return policy for defects</span>
                </div>
                <div class="d-flex align-items-center gap-3 small text-muted">
                    <i class="bi bi-shield-check text-primary fs-5"></i>
                    <span>12-month manufacturer official warranty</span>
                </div>
            </div>
        </div>
    </div>
    <section class="mt-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h4 fw-bold mb-0">
                <i class="bi bi-star-fill text-warning me-2"></i>Customer Reviews
            </h2>
            <span class="text-muted small">@Model.Reviews.Count review(s)</span>
        </div>

        @if (Model.Reviews.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-chat-square-text fs-1 d-block mb-2"></i>
                    <p class="mb-0">This product has no published reviews yet.</p>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var review in Model.Reviews)
                {
                    <article class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                <div>
                                    <div class="fw-semibold">
                                        @(string.IsNullOrWhiteSpace(review.CustomerName) ? "Customer" : review.CustomerName)
                                    </div>
                                    <div class="text-warning small" aria-label="@review.Rating out of 5 stars">
                                        @for (var star = 1; star <= 5; star++)
                                        {
                                            <i class="bi @(star <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                        }
                                    </div>
                                </div>
                                <time class="text-muted small" datetime="@review.CreatedAt.ToString("O")">
                                    @review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                </time>
                            </div>
                            <p class="mb-0 text-secondary" style="white-space: pre-line;">@review.Content</p>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        let _currentVariantId = '@(defaultVariant?.ProductVariantId.ToString() ?? "")';
        let _currentStock = @(defaultVariant?.StockQuantity ?? 0);

        function switchDetailVariant(id, price, stock, img, btn) {
            _currentVariantId = id;
            _currentStock = parseInt(stock) || 0;

            document.querySelectorAll('.variant-pill-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const formatted = new Intl.NumberFormat('vi-VN').format(price) + ' ₫';
            document.getElementById('detailPrice').innerText = formatted;

            if (img && img !== '') {
                document.getElementById('detailMainImg').src = img;
            }

            const badge = document.getElementById('detailStockBadge');
            const btnCart = document.getElementById('btnDetailAddToCart');

            if (_currentStock > 0) {
                badge.innerHTML = `<span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold"><i class="bi bi-check-circle-fill me-1"></i> In Stock (${_currentStock} available)</span>`;
                btnCart.disabled = false;
                btnCart.innerHTML = '<i class="bi bi-cart-plus me-2 fs-5"></i> Add to Cart';
            } else {
                badge.innerHTML = `<span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold"><i class="bi bi-x-circle-fill me-1"></i> Out of Stock</span>`;
                btnCart.disabled = true;
                btnCart.innerHTML = '<i class="bi bi-x-circle me-2"></i> Out of Stock';
            }
        }

        function adjustDetailQty(delta) {
            const input = document.getElementById('detailQtyInput');
            let val = (parseInt(input.value) || 1) + delta;
            if (val < 1) val = 1;
            if (val > _currentStock && _currentStock > 0) {
                showToast("Only " + _currentStock + " units available in stock.", "info");
                val = _currentStock;
            }
            input.value = val;
        }

        function submitDetailAddToCart() {
            if (!_currentVariantId) {
                showToast("Please select a variant.", "info");
                return;
            }

            const qty = parseInt(document.getElementById('detailQtyInput').value) || 1;
            const btn = document.getElementById('btnDetailAddToCart');
            btn.disabled = true;

            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: { variantId: _currentVariantId, quantity: qty },
                success: function (res) {
                    btn.disabled = false;
                    if (res.success) {
                        refreshCartBadge();
                        showToast(res.message, "success", "Cart Updated");
                    } else {
                        showToast(res.message, "error", "Add Failed");
                    }
                },
                error: function (xhr) {
                    btn.disabled = false;
                    if (xhr.status === 401 || xhr.status === 403) {
                        window.location.href = '@Url.Action("CustomerLogin", "Auth")?returnUrl=' + encodeURIComponent(window.location.pathname);
                    } else {
                        showToast("Could not communicate with cart service.", "error");
                    }
                }
            });
        }
    </script>
}
