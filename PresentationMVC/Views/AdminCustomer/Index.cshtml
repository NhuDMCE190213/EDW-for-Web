@model PresentationMVC.Models.CustomerIndexViewModel
@{
    ViewData["Title"] = "Customer Management";
}

<div class="admin-page">
    <div class="status-toast-container" id="toastContainer"></div>

    <div class="admin-page-heading">
        <div>
            <h1>Customer Management</h1>
            <p>View registered customers, manage reward points, and toggle account activation status.</p>
        </div>
        <div>
            <a class="btn btn-danger" asp-action="Create">
                <i class="bi bi-person-plus me-1"></i> Add New Customer
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="admin-stat">
                <div>
                    <small>TOTAL CUSTOMERS</small>
                    <strong>@Model.TotalCount</strong>
                </div>
                <span><i class="bi bi-people text-primary"></i></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="admin-stat admin-stat-green">
                <div>
                    <small>ACTIVE CUSTOMERS</small>
                    <strong>@Model.ActiveCount</strong>
                </div>
                <span><i class="bi bi-person-check text-success"></i></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="admin-stat admin-stat-blue">
                <div>
                    <small>INACTIVE CUSTOMERS</small>
                    <strong>@(Math.Max(0, Model.TotalCount - Model.ActiveCount))</strong>
                </div>
                <span><i class="bi bi-person-x text-muted"></i></span>
            </div>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label text-muted small fw-bold">Search Customers</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input name="search" value="@Model.Search" class="form-control border-start-0 bg-light" placeholder="Search name, email, or phone..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-bold">Status Filter</label>
                    <select name="status" class="form-select bg-light">
                        <option value="all" selected="@(Model.StatusFilter == "all" || string.IsNullOrEmpty(Model.StatusFilter))">All Statuses</option>
                        <option value="active" selected="@(Model.StatusFilter == "active")">Active Only</option>
                        <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive Only</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-outline-secondary flex-grow-1" type="submit">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Search) || (Model.StatusFilter != "all" && !string.IsNullOrEmpty(Model.StatusFilter)))
                    {
                        <a asp-action="Index" class="btn btn-outline-dark" title="Clear Filters">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Customer List Card -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">Customer List <span class="text-muted fw-normal fs-6">(@Model.TotalCount)</span></h5>
        </div>
        <div class="card-body p-0">

        @if (Model.Customers.Count == 0)
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-people display-4 d-block mb-3"></i>
                <h5>No customers found</h5>
                <p>Try adjusting your search criteria or add a new customer.</p>
                <a asp-action="Create" class="btn btn-danger btn-sm">Add Customer</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 70px;">ID</th>
                            <th>Customer</th>
                            <th>Email Address</th>
                            <th>Phone Number</th>
                            <th>Reward Points</th>
                            <th style="width: 140px;" class="text-center">Status</th>
                            <th>Registered</th>
                            <th style="width: 150px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr id="customer-row-@customer.CustomerId">
                            <td class="fw-bold text-secondary">#@customer.CustomerId</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 0.95rem;">
                                        @(string.IsNullOrWhiteSpace(customer.FullName) ? "C" : customer.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@customer.FullName</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="mailto:@customer.Email" class="text-decoration-none text-muted">
                                    <i class="bi bi-envelope me-1"></i>@customer.Email
                                </a>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(customer.PhoneNumber))
                                {
                                    <span class="text-muted"><i class="bi bi-telephone me-1"></i>@customer.PhoneNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">None</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-warning-subtle text-dark border px-2 py-1">
                                    <i class="bi bi-star-fill text-warning me-1"></i>@customer.Points.ToString("N0") pts
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <label class="custom-status-switch" title="Toggle active status">
                                        <input type="checkbox" 
                                               class="customer-status-toggle" 
                                               data-id="@customer.CustomerId" 
                                               data-name="@customer.FullName" 
                                               @(customer.IsActive ? "checked" : "") />
                                        <span class="custom-status-slider"></span>
                                    </label>
                                    <span class="badge @(customer.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-muted") status-label" id="status-badge-@customer.CustomerId" style="font-size: 0.75rem;">
                                        @(customer.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                            </td>
                            <td class="text-muted" style="font-size: 0.85rem;">
                                @customer.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary me-1" asp-action="Edit" asp-route-id="@customer.CustomerId" title="Edit Customer">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@customer.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete customer: @customer.FullName?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete Customer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top">
                    <div class="text-muted small">
                        Showing page @Model.Page of @Model.TotalPages (@Model.TotalCount total items)
                    </div>
                    <nav aria-label="Customer navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggles = document.querySelectorAll(".customer-status-toggle");

        toggles.forEach(toggle => {
            toggle.addEventListener("change", async function () {
                const customerId = this.dataset.id;
                const customerName = this.dataset.name;
                const isChecked = this.checked;
                const badge = document.getElementById("status-badge-" + customerId);

                try {
                    const response = await fetch(`/AdminCustomer/ToggleStatus?id=${customerId}`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });

                    if (!response.ok) {
                        throw new Error("Server returned status " + response.status);
                    }

                    const data = await response.json();
                    if (data.success) {
                        this.checked = data.isActive;
                        if (badge) {
                            badge.textContent = data.isActive ? "Active" : "Inactive";
                            badge.className = "badge status-label " + (data.isActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-muted");
                        }
                        showToast(`Status of "${customerName}" set to ${data.isActive ? 'Active' : 'Inactive'}.`, "success");
                    } else {
                        throw new Error(data.message || "Failed to toggle status");
                    }
                } catch (err) {
                    console.error("Toggle error:", err);
                    this.checked = !isChecked;
                    showToast(`Failed to update status for "${customerName}".`, "danger");
                }
            });
        });

        function showToast(message, type) {
            const container = document.getElementById("toastContainer");
            if (!container) return;

            const toast = document.createElement("div");
            toast.className = `alert alert-${type} shadow-sm d-flex align-items-center justify-content-between p-2 mb-2 fade show`;
            toast.style.borderRadius = "8px";
            toast.innerHTML = `
                <div class="small fw-medium">${message}</div>
                <button type="button" class="btn-close ms-2" style="font-size: 0.65rem;" onclick="this.parentElement.remove()"></button>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.remove("show");
                setTimeout(() => toast.remove(), 250);
            }, 3500);
        }
    });
</script>
}
