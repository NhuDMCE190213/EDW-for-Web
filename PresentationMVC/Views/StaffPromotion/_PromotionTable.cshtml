@model PresentationMVC.Models.Promotion.StaffPromotionIndexViewModel

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-success text-white h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-white bg-opacity-25 rounded-circle p-3 me-4">
                    <i class="bi bi-check2-circle fs-3"></i>
                </div>
                <div>
                    <h6 class="text-white-50 mb-1">Active Promotions</h6>
                    <h3 class="mb-0 fw-bold">@(Model.PromotionData?.ActiveCount ?? 0)</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-info text-white h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-white bg-opacity-25 rounded-circle p-3 me-4">
                    <i class="bi bi-calendar-event fs-3"></i>
                </div>
                <div>
                    <h6 class="text-white-50 mb-1">Upcoming Promotions</h6>
                    <h3 class="mb-0 fw-bold">@(Model.PromotionData?.Upcoming ?? 0)</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-danger text-white h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-white bg-opacity-25 rounded-circle p-3 me-4">
                    <i class="bi bi-x-circle fs-3"></i>
                </div>
                <div>
                    <h6 class="text-white-50 mb-1">Expired</h6>
                    <h3 class="mb-0 fw-bold">@(Model.PromotionData?.ExpiredOrDisabledCount ?? 0)</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Name</th>
                        <th class="py-3">Type</th>
                        <th class="py-3">Discount</th>
                        <th class="py-3">Stock Limit</th>
                        <th class="py-3">Period</th>
                        <th class="py-3">Status</th>
                        <th class="pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model.PromotionData?.Pagination?.Items != null && Model.PromotionData.Pagination.Items.Any())
                    {
                        foreach (var item in Model.PromotionData.Pagination.Items)
                        {
                            var displayName = item.Name ?? "Unnamed";
                            if (!string.IsNullOrEmpty(item.Name))
                            {
                                var match = System.Text.RegularExpressions.Regex.Match(item.Name, @"\(([^)]+)\)");
                                if (match.Success)
                                {
                                    displayName = match.Groups[1].Value;
                                }
                            }

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@displayName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.PromotionType</span>
                                </td>
                                <td>
                                    @{
                                        string formattedDiscount = "";
                                        if (item.PromotionType == DAL.Enums.PromotionTypeEnum.Percentage)
                                        {
                                            formattedDiscount = "-" + (item.Percentage ?? 0).ToString("0.##", new System.Globalization.CultureInfo("en-US")) + "%";
                                        }
                                        else
                                        {
                                            formattedDiscount = "-$" + (item.SalePrice ?? 0).ToString("#,##0.##", new System.Globalization.CultureInfo("en-US"));
                                        }
                                        var parts = formattedDiscount.Split('.');
                                    }
                                    <span class="fw-bold" style="color: #008060;">@parts[0]</span>@if(parts.Length > 1){<span class="text-warning fw-bold">.@parts[1]</span>}
                                    @if (item.ThresholdPrice > 0)
                                    {
                                        <div class="small text-muted mt-1">Min: $@((item.ThresholdPrice ?? 0).ToString("#,##0.##", new System.Globalization.CultureInfo("en-US")))</div>
                                    }
                                </td>
                                <td>
                                    @if (item.IsReservedStock)
                                    {
                                        <small>Stock: @item.MaxReservedStock</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted"><i class="bi bi-infinity"></i></span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsLimitedTime)
                                    {
                                        <div class="small"><i class="bi bi-clock text-warning"></i> @item.StartAt?.ToString("dd/MM/yyyy")</div>
                                        <div class="small"><i class="bi bi-clock-history text-danger"></i> @item.EndAt?.ToString("dd/MM/yyyy")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted"><i class="bi bi-infinity"></i> Unlimited</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsDeleted)
                                    {
                                        <span class="badge bg-dark">Deleted</span>
                                    }
                                    else if (item.IsDisabled)
                                    {
                                        <span class="badge bg-secondary">Disabled</span>
                                    }
                                    else
                                    {
                                        var now = DateTime.UtcNow;
                                        if (item.IsLimitedTime && item.EndAt < now)
                                        {
                                            <span class="badge bg-danger">Expired</span>
                                        }
                                        else if (item.IsLimitedTime && item.StartAt > now)
                                        {
                                            <span class="badge bg-info">Upcoming</span>
                                        }
                                        else if (item.IsReservedStock && item.MaxReservedStock <= 0)
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-controller="StaffPromotion" asp-route-id="@item.PromotionId" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (!item.IsDeleted)
                                        {
                                            <form asp-action="Delete" asp-controller="StaffPromotion" asp-route-id="@item.PromotionId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete/disable this promotion?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No promotions found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.PromotionData != null && Model.PromotionData.Pagination.TotalPages > 1)
    {
        <div class="card-footer bg-white p-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Showing Page @Model.PromotionData.Pagination.Page of @Model.PromotionData.Pagination.TotalPages</span>
            <nav>
                <ul class="pagination pagination-sm m-0">
                    <li class="page-item @(Model.PromotionData.Pagination.Page == 1 ? "disabled" : "")">
                        <a href="javascript:void(0)" onclick="loadPage(@(Model.PromotionData.Pagination.Page - 1))" class="page-link">Prev</a>
                    </li>
                    @{
                        int startPage = Math.Max(1, Model.PromotionData.Pagination.Page - 2);
                        int endPage = Math.Min(Model.PromotionData.Pagination.TotalPages, Model.PromotionData.Pagination.Page + 2);
                        
                        if (startPage > 1)
                        {
                            <li class="page-item"><a href="javascript:void(0)" onclick="loadPage(1)" class="page-link">1</a></li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(Model.PromotionData.Pagination.Page == i ? "active" : "")">
                                <a href="javascript:void(0)" onclick="loadPage(@i)" class="page-link">@i</a>
                            </li>
                        }

                        if (endPage < Model.PromotionData.Pagination.TotalPages)
                        {
                            if (endPage < Model.PromotionData.Pagination.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item"><a href="javascript:void(0)" onclick="loadPage(@Model.PromotionData.Pagination.TotalPages)" class="page-link">@Model.PromotionData.Pagination.TotalPages</a></li>
                        }
                    }
                    <li class="page-item @(Model.PromotionData.Pagination.Page == Model.PromotionData.Pagination.TotalPages ? "disabled" : "")">
                        <a href="javascript:void(0)" onclick="loadPage(@(Model.PromotionData.Pagination.Page + 1))" class="page-link">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
