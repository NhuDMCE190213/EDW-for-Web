@model PresentationMVC.Models.Promotion.StaffPromotionIndexViewModel
@{
    ViewData["Title"] = "Manage Promotions";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0 text-gray-800 fw-bold"><i class="bi bi-tags text-danger me-2"></i>Promotions Management</h2>
        <a asp-action="Create" class="btn btn-danger shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i> Create New Promotion
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filters -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <form id="filterForm" class="row g-3">
                <input type="hidden" name="PageNumber" id="PageNumber" value="@Model.PageNumber" />
                
                <!-- Search -->
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">Search Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchName" id="SearchName" value="@Model.SearchName" class="form-control border-start-0 bg-light" placeholder="Promotion name...">
                    </div>
                </div>

                <!-- Start Date -->
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Start Date</label>
                    <input type="date" name="StartAt" id="StartAt" value="@Model.StartAt?.ToString("yyyy-MM-dd")" class="form-control bg-light">
                </div>

                <!-- End Date -->
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">End Date</label>
                    <input type="date" name="EndAt" id="EndAt" value="@Model.EndAt?.ToString("yyyy-MM-dd")" class="form-control bg-light">
                </div>

                <!-- Discount Filter -->
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">Discount Filter</label>
                    <div class="dropdown">
                        <button class="btn btn-light border w-100 text-start d-flex justify-content-between align-items-center" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                            <span><i class="bi bi-sliders"></i> Select Discount</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="dropdown-menu p-3 shadow-lg border-0 rounded-3" style="width: 300px; z-index: 1050;">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Type</label>
                                <div class="d-flex gap-3 align-items-center">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input discount-type" type="radio" name="DiscountType" value="0" id="typePercent" @(Model.DiscountType == DAL.Enums.PromotionTypeEnum.Percentage ? "checked" : "")>
                                        <label class="form-check-label" for="typePercent">% Percent</label>
                                    </div>
                                    <div class="form-check mb-0 d-flex align-items-center gap-1">
                                        <input class="form-check-input discount-type" type="radio" name="DiscountType" value="1" id="typeFixed" @(Model.DiscountType == DAL.Enums.PromotionTypeEnum.FixedAmount ? "checked" : "")>
                                        <label class="form-check-label" for="typeFixed">$ Cost</label>
                                        <button type="button" id="btnClearDiscountType" class="btn btn-sm btn-outline-danger p-0 ms-1 d-flex justify-content-center align-items-center" style="width: 18px; height: 18px; font-size: 0.7rem; border-radius: 50%;" title="Clear Type"><i class="bi bi-x"></i></button>
                                    </div>
                                </div>
                            </div>
                            <div id="rangeSection">
                                <label class="form-label small fw-bold d-flex justify-content-between">
                                    <span>Range</span>
                                    <span id="rangeDisplay" class="text-danger">0 - 100</span>
                                </label>
                                <div class="position-relative mt-2 dual-slider-container" style="height: 30px;">
                                    <input type="range" class="form-range position-absolute w-100 dual-slider" id="MinDiscount" name="MinDiscount" min="0" max="100" value="@(Model.MinDiscount ?? 0)">
                                    <input type="range" class="form-range position-absolute w-100 dual-slider" id="MaxDiscount" name="MaxDiscount" min="0" max="100" value="@(Model.MaxDiscount ?? 100)">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Filter -->
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">Status Filter</label>
                    <div class="dropdown">
                        <button class="btn btn-light border w-100 text-start d-flex justify-content-between align-items-center" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                            <span><i class="bi bi-funnel"></i> Options</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="dropdown-menu p-3 shadow-lg border-0 rounded-3" style="width: 250px; z-index: 1050;">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input auto-submit" type="checkbox" name="IncludeActive" value="true" @(Model.IncludeActive ? "checked" : "") id="chkActive">
                                <label class="form-check-label" for="chkActive">Include Active</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input auto-submit" type="checkbox" name="IncludeUpcoming" value="true" @(Model.IncludeUpcoming ? "checked" : "") id="chkUpcoming">
                                <label class="form-check-label" for="chkUpcoming">Include Upcoming</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input auto-submit" type="checkbox" name="IncludeExpired" value="true" @(Model.IncludeExpired ? "checked" : "") id="chkExpired">
                                <label class="form-check-label" for="chkExpired">Include Expired</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input auto-submit" type="checkbox" name="IncludeOutOfStock" value="true" @(Model.IncludeOutOfStock ? "checked" : "") id="chkOutOfStock">
                                <label class="form-check-label" for="chkOutOfStock">Include Out Of Stock</label>
                            </div>
                            
                            <hr class="my-2">
                            
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input auto-submit" type="checkbox" name="IncludeDeleted" value="true" @(Model.IncludeDeleted ? "checked" : "") id="chkDeleted">
                                <label class="form-check-label text-danger" for="chkDeleted">Include Deleted</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input auto-submit" type="checkbox" name="IncludeDisabled" value="true" @(Model.IncludeDisabled ? "checked" : "") id="chkDisabled">
                                <label class="form-check-label text-secondary" for="chkDisabled">Include Disabled</label>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>



    <!-- Table Container for Partial View -->
    <div id="tableContainer" class="position-relative">
        <div id="loadingOverlay" class="position-absolute w-100 h-100 d-none" style="z-index: 10; background: rgba(255,255,255,0.7); backdrop-filter: blur(2px);">
            <div class="d-flex justify-content-center align-items-center h-100">
                <div class="spinner-border text-danger" role="status"></div>
            </div>
        </div>
        
        <div id="tableContent">
            @await Html.PartialAsync("_PromotionTable", Model)
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .dual-slider-container input[type=range] {
            pointer-events: none;
            -webkit-appearance: none;
            background: transparent;
        }
        .dual-slider-container input[type=range]::-webkit-slider-thumb {
            pointer-events: all;
            position: relative;
            z-index: 3;
            appearance: none;
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #dc3545;
            cursor: pointer;
            margin-top: -6px; /* align center with track */
        }
        .dual-slider-container input[type=range]::-moz-range-thumb {
            pointer-events: all;
            position: relative;
            z-index: 3;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #dc3545;
            cursor: pointer;
        }
        .dual-slider-container input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 4px;
            background: #dee2e6;
            border-radius: 2px;
        }
        /* Hide track for second slider to prevent double thickness visually */
        #MaxDiscount::-webkit-slider-runnable-track {
            background: transparent;
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // --- DUAL SLIDER LOGIC ---
            const minSlider = document.getElementById('MinDiscount');
            const maxSlider = document.getElementById('MaxDiscount');
            const rangeDisplay = document.getElementById('rangeDisplay');
            const typeRadios = document.querySelectorAll('.discount-type');

            function updateSliderStyle() {
                // Ensure Min <= Max visually
                if (parseInt(minSlider.value) > parseInt(maxSlider.value)) {
                    let tmp = minSlider.value;
                    minSlider.value = maxSlider.value;
                    maxSlider.value = tmp;
                }
                
                let isPercent = document.getElementById('typePercent').checked;
                let unit = isPercent ? '%' : '$';
                rangeDisplay.innerText = `${minSlider.value}${unit} - ${maxSlider.value}${unit}`;
            }

            const rangeSection = document.getElementById('rangeSection');
            const btnClearType = document.getElementById('btnClearDiscountType');
            let currentDiscountType = document.querySelector('input[name="DiscountType"]:checked')?.value || null;

            function updateDiscountUI() {
                if (currentDiscountType !== null) {
                    rangeSection.style.display = 'block';
                    btnClearType.style.display = 'flex';
                } else {
                    rangeSection.style.display = 'none';
                    btnClearType.style.display = 'none';
                }
            }

            typeRadios.forEach(r => r.addEventListener('click', function(e) {
                if (this.value === currentDiscountType) {
                    this.checked = false;
                    currentDiscountType = null;
                } else {
                    currentDiscountType = this.value;
                }
                updateDiscountUI();
                
                if (currentDiscountType !== null) {
                    let isPercent = currentDiscountType === "0";
                    let mMax = isPercent ? 100 : @(Math.Ceiling(Model.MaxCost > 0 ? Model.MaxCost : 1000M));
                    minSlider.max = mMax;
                    maxSlider.max = mMax;
                    if(isPercent) {
                        if (minSlider.value > 100) minSlider.value = 0;
                        if (maxSlider.value > 100) maxSlider.value = 100;
                    }
                    updateSliderStyle();
                }
                
                fetchTableData();
            }));

            btnClearType.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                typeRadios.forEach(r => r.checked = false);
                currentDiscountType = null;
                updateDiscountUI();
                fetchTableData();
            });

            updateDiscountUI();

            minSlider.addEventListener('input', updateSliderStyle);
            maxSlider.addEventListener('input', updateSliderStyle);
            
            minSlider.addEventListener('change', fetchTableData); // triggers on mouseup/touchend
            maxSlider.addEventListener('change', fetchTableData);

            updateSliderStyle();

            // --- AUTO SUBMIT (AJAX) LOGIC ---
            let debounceTimer;
            const searchInput = document.getElementById('SearchName');
            
            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(fetchTableData, 400); // 400ms debounce
            });

            const autoSubmitInputs = document.querySelectorAll('.auto-submit, #StartAt, #EndAt');
            autoSubmitInputs.forEach(input => {
                input.addEventListener('change', fetchTableData);
            });

            window.loadPage = function(pageNumber) {
                document.getElementById('PageNumber').value = pageNumber;
                fetchTableData();
            };

            function fetchTableData() {
                const overlay = document.getElementById('loadingOverlay');
                overlay.classList.remove('d-none');

                const form = document.getElementById('filterForm');
                const formData = new FormData(form);
                
                form.querySelectorAll('input[type="checkbox"]').forEach(chk => {
                    if (!chk.checked) {
                        formData.append(chk.name, 'false');
                    }
                });

                const params = new URLSearchParams(formData);
                
                // --- Keep URL updated with filters for returnUrl logic ---
                window.history.replaceState(null, '', '?' + params.toString());

                fetch(`@Url.Action("Table", "StaffPromotion")?${params.toString()}`)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById('tableContent').innerHTML = html;
                    })
                    .finally(() => {
                        overlay.classList.add('d-none');
                    });
            }

            // --- SIGNALR REALTIME LOGIC ---
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("https://localhost:7278/promotionHub") 
                .withAutomaticReconnect()
                .build();

            connection.on("OnPromotionChanged", function () {
                // Background refresh when other clients or API changes data
                fetchTableData(); 
            });

            connection.on("PromotionLocked", function (promotionId) {
                // Someone else is editing
                const btn = document.querySelector(`.btn-edit-promotion[data-id='${promotionId}']`);
                if (btn) {
                    btn.classList.add('disabled');
                    btn.style.pointerEvents = 'none';
                    btn.title = "This promotion is currently being edited by someone else.";
                }
            });

            connection.on("PromotionUnlocked", function (promotionId) {
                // Someone else finished editing
                const btn = document.querySelector(`.btn-edit-promotion[data-id='${promotionId}']`);
                if (btn) {
                    btn.classList.remove('disabled');
                    btn.style.pointerEvents = 'auto';
                    btn.title = "Edit";
                }
            });

            connection.start().then(() => {
                connection.invoke("GetLockedPromotions").then(ids => {
                    ids.forEach(id => {
                        const btn = document.querySelector(`.btn-edit-promotion[data-id='${id}']`);
                        if (btn) {
                            btn.classList.add('disabled');
                            btn.style.pointerEvents = 'none';
                            btn.title = "This promotion is currently being edited by someone else.";
                        }
                    });
                });
            }).catch(err => console.error(err.toString()));
        });
    </script>
}
