@model PresentationMVC.Models.Promotion.PromotionDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Promotion Detail - Enterprise Management</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script>
        tailwind.config = {
          theme: {
            extend: {
              fontFamily: {
                sans: ['Inter', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif']
              }
            }
          }
        }
    </script>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 flex items-center justify-center p-4 sm:p-6 lg:p-8 font-sans antialiased relative">
    


    <main class="w-full max-w-2xl bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden">
        <header class="px-6 py-5 sm:px-8 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-slate-50 via-white to-blue-50/30">
            <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shadow-sm flex-shrink-0 mt-0.5">
                    <svg class="w-5 h-5 stroke-[2.2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl sm:text-2xl font-bold text-slate-800 tracking-tight">Promotion Detail</h1>
                    </div>
                    <p class="text-sm text-slate-500 mt-1">ID: @Model.PromotionId</p>
                </div>
            </div>
            <div>
                @if (Model.IsDeleted)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                        Deleted
                    </span>
                }
                else if (Model.IsDisabled)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                        Disabled
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        Active
                    </span>
                }
            </div>
        </header>

        <div class="p-6 sm:p-8 space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Name -->
                <div class="sm:col-span-2">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Promotion Name</h3>
                    <p class="text-lg font-semibold text-slate-800">@Model.Name</p>
                </div>

                <!-- Type -->
                <div>
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Type</h3>
                    <p class="text-slate-800 font-medium">
                        <span class="inline-block px-2 py-1 bg-slate-100 border border-slate-200 rounded-md text-sm">
                            @Model.PromotionType
                        </span>
                    </p>
                </div>

                <!-- Value -->
                <div>
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Discount Value</h3>
                    <p class="text-slate-800 font-bold text-lg text-emerald-600">
                        @if (Model.PromotionType == PresentationMVC.Models.Promotion.PromotionType.Percentage)
                        {
                            <text>@Model.Percentage?.ToString("0.##")%</text>
                        }
                        else
                        {
                            <text>$@Model.SalePrice?.ToString("#,##0.##")</text>
                            @if (Model.ThresholdPrice > 0)
                            {
                                <span class="text-sm font-normal text-slate-500 block mt-1">Min Purchase: $@Model.ThresholdPrice?.ToString("#,##0.##")</span>
                            }
                        }
                    </p>
                </div>

                <!-- Timing -->
                <div>
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Period</h3>
                    @if (Model.IsLimitedTime)
                    {
                        <div class="text-sm text-slate-700 space-y-1">
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                @Model.StartAt?.ToString("dd MMM yyyy, HH:mm")
                            </div>
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                @Model.EndAt?.ToString("dd MMM yyyy, HH:mm")
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-slate-800 font-medium">Unlimited Time</p>
                    }
                </div>

                <!-- Stock -->
                <div>
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Stock Limit</h3>
                    @if (Model.IsReservedStock)
                    {
                        <p class="text-slate-800 font-medium">@Model.MaxReservedStock items</p>
                    }
                    else
                    {
                        <p class="text-slate-800 font-medium text-slate-500"><i class="bi bi-infinity"></i> Unlimited Stock</p>
                    }
                </div>
            </div>
        </div>

        <footer class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex items-center justify-end gap-3">
            <a href="@ViewBag.ReturnUrl" class="px-5 py-2.5 rounded-lg border border-slate-300 bg-white text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition-colors shadow-sm active:scale-[0.98]">
                Go Back
            </a>
            @if (!Model.IsDeleted)
            {
                <a href="/StaffPromotion/Edit/@Model.PromotionId" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white text-sm font-semibold shadow-md shadow-blue-500/20 transition-all active:scale-[0.98]">
                    <svg class="w-4 h-4 stroke-[2.2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
                    </svg>
                    Edit Promotion
                </a>
            }
        </footer>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const promotionId = '@Model.PromotionId';
            const returnUrl = '@Html.Raw(ViewBag.ReturnUrl)';

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("https://localhost:7278/promotionHub") 
                .withAutomaticReconnect()
                .build();

            // When someone else updates THIS promotion
            connection.on("PromotionUpdated", function (updatedId) {
                if (updatedId === promotionId) {
                    console.log("Promotion was updated, reloading page to reflect changes...");
                    window.location.reload();
                }
            });

            // When someone else deletes THIS promotion
            connection.on("PromotionDeleted", function (deletedId) {
                if (deletedId === promotionId) {
                    console.log("Promotion was deleted, reloading page to reflect deleted status...");
                    window.location.reload();
                }
            });

            connection.start().catch(err => console.error(err.toString()));
        });
    </script>
</body>
</html>
