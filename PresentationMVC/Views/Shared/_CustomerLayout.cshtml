<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECommerse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="customer-shell">
    <header>
        <nav class="customer-navbar">
            <div class="container-fluid px-4">
                <div class="d-flex align-items-center gap-4 flex-wrap">
                    <a class="customer-brand" asp-controller="Home" asp-action="Customer">
                        <i class="bi bi-phone-vibrate"></i> ECommerse
                    </a>
                    <button class="navbar-toggler border-0 text-white d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#customerNavigation" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div id="customerNavigation" class="navbar-collapse collapse d-lg-flex flex-grow-1 align-items-center gap-3">
                        <form class="d-flex flex-grow-1 customer-search-form" asp-controller="Home" asp-action="Customer" method="get">
                            <input name="q" value="@Context.Request.Query["q"]" class="form-control customer-search" type="search" placeholder="Search phones, laptops, accessories..." aria-label="Search products" />
                            <button class="customer-search-btn" type="submit"><i class="bi bi-search"></i></button>
                        </form>
                        <div class="d-flex align-items-center gap-3 ms-auto">
                            <a class="customer-icon-link" asp-controller="Home" asp-action="Customer">
                                <i class="bi bi-grid-fill"></i><span>Shop</span>
                            </a>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a class="customer-icon-link" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person-fill"></i><span>Account</span>
                                </a>
                                <a class="customer-icon-link" asp-controller="Orders" asp-action="Index">
                                    <i class="bi bi-bag-check-fill"></i><span>My Orders</span>
                                </a>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="customer-auth-link customer-link-button">Log out</button>
                                </form>
                            }
                            else
                            {
                                <a class="customer-auth-link" asp-controller="Auth" asp-action="CustomerLogin">Sign in</a>
                                <a class="customer-auth-link" asp-controller="Auth" asp-action="Register">Sign up</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
        <nav class="customer-subnav">
            <div class="container-fluid px-4">
                <div class="d-flex overflow-auto">
                    <a class="customer-subnav-link" asp-controller="Home" asp-action="Customer"><i class="bi bi-grid-fill me-1"></i> All Products</a>
                    <a class="customer-subnav-link" asp-controller="Home" asp-action="Customer" asp-route-category="Phones"><i class="bi bi-phone me-1"></i> Phones</a>
                    <a class="customer-subnav-link" asp-controller="Home" asp-action="Customer" asp-route-category="Laptops"><i class="bi bi-laptop me-1"></i> Laptops</a>
                    <a class="customer-subnav-link" asp-controller="Home" asp-action="Customer" asp-route-category="Tablets"><i class="bi bi-tablet me-1"></i> Tablets</a>
                    <a class="customer-subnav-link" asp-controller="Home" asp-action="Customer" asp-route-category="Accessories"><i class="bi bi-plug me-1"></i> Accessories</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container customer-content">
        <main role="main">@RenderBody()</main>
    </div>
    <footer class="customer-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span>&copy; 2026 - <strong>ECommerse</strong> - Electronics Store</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
