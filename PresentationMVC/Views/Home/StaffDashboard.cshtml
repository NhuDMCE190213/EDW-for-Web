@model PresentationMVC.Models.Order.Staff.OrderDashboardModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="admin-page order-dashboard-page">
    <div class="admin-page-heading">
        <div>
            <h1>Staff Dashboard</h1>
            <p>Monitor order activity and store revenue.</p>
        </div>
        <span class="admin-page-badge"><i class="bi bi-person-badge me-1"></i> Staff workspace</span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="admin-stat order-dashboard-stat">
                <div><small>TOTAL ORDERS</small><strong>@Model.TotalOrders</strong><span class="stat-caption">All customer orders</span></div>
                <span><i class="bi bi-receipt-cutoff"></i></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="admin-stat admin-stat-green order-dashboard-stat">
                <div><small>TOTAL REVENUE</small><strong>@Model.TotalRevenue.ToString("N0") ₫</strong><span class="stat-caption">Gross order value</span></div>
                <span><i class="bi bi-graph-up-arrow"></i></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="admin-stat admin-stat-blue order-dashboard-stat">
                <div><small>PENDING ORDERS</small><strong>@Model.PendingOrders</strong><span class="stat-caption">Need staff attention</span></div>
                <span><i class="bi bi-hourglass-split"></i></span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="admin-panel order-overview-panel">
                <div class="admin-panel-heading"><h2>Fulfillment overview</h2><i class="bi bi-bar-chart-line text-danger fs-4"></i></div>
                <div class="order-progress-row"><div><span>Pending orders</span><strong>@Model.PendingOrders</strong></div><div class="progress"><div class="progress-bar bg-warning" style="width: @(Model.TotalOrders == 0 ? 0 : Math.Min(100, Model.PendingOrders * 100 / Model.TotalOrders))%"></div></div></div>
                <div class="order-progress-row"><div><span>Orders completed</span><strong>@(Model.TotalOrders - Model.PendingOrders)</strong></div><div class="progress"><div class="progress-bar bg-success" style="width: @(Model.TotalOrders == 0 ? 0 : Math.Max(0, (Model.TotalOrders - Model.PendingOrders) * 100 / Model.TotalOrders))%"></div></div></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="admin-panel order-action-panel">
                <h2>Quick actions</h2>
                <a asp-controller="StaffOrder" asp-action="Index" class="btn btn-ds-primary w-100 mb-2"><i class="bi bi-pencil-square me-2"></i>Process orders</a>
                <a asp-controller="StaffProduct" asp-action="Index" class="btn btn-outline-secondary w-100"><i class="bi bi-box-seam me-2"></i>View products</a>
            </div>
        </div>
    </div>
</div>
