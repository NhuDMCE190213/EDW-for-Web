@model PresentationMVC.Models.EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            &larr; Back to Profile
        </a>
        <h2 class="m-0 fw-medium ds-heading-accent">Edit Profile</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card ds-card shadow-sm p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Role" />

                    <!-- Account Info Readonly -->
                    <div class="mb-4 p-3 rounded-3" style="background-color: #F8F9FA;">
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <label class="text-muted small fw-medium text-uppercase mb-1 d-block">Account Email</label>
                                <span class="fw-semibold text-dark">@Model.Email</span>
                            </div>
                            <div class="col-sm-6">
                                <label class="text-muted small fw-medium text-uppercase mb-1 d-block">Role</label>
                                <span class="badge rounded-pill px-3 py-1" style="background-color: #FCEBEB; color: #A32D2D;">
                                    @Model.Role
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Editable Fields -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-medium text-dark">Full Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="FullName" class="form-control border-start-0" placeholder="Enter your full name" autofocus />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    @if (Model.IsCustomer)
                    {
                        <div class="mb-4">
                            <label asp-for="PhoneNumber" class="form-label fw-medium text-dark">Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-telephone"></i>
                                </span>
                                <input asp-for="PhoneNumber" class="form-control border-start-0" placeholder="0912345678" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-ds-secondary px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-ds-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
