@model PresentationMVC.Models.UserProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">
    <!-- Breadcrumb / Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0 fw-medium ds-heading-accent">Account Profile</h2>
        <div class="d-flex gap-2">
            <a asp-action="Edit" class="btn btn-ds-primary">
                <i class="bi bi-pencil-square me-1"></i> Edit Profile
            </a>
            <a asp-action="ChangePassword" class="btn btn-ds-secondary">
                <i class="bi bi-shield-lock me-1"></i> Change Password
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success d-flex align-items-center mb-4 border-0 rounded-3 shadow-sm" style="background-color: #EAF3DE; color: #27500A;">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@success</div>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4 border-0 rounded-3 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@error</div>
        </div>
    }

    <div class="row g-4">
        <!-- Profile Overview Card -->
        <div class="col-lg-4">
            <div class="card ds-card shadow-sm text-center p-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center text-white rounded-circle fw-bold shadow-sm"
                     style="width: 88px; height: 88px; background: linear-gradient(135deg, #E24B4A, #A32D2D); font-size: 2rem;">
                    @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                </div>
                <h4 class="fw-semibold mb-1 text-dark">@Model.FullName</h4>
                <p class="text-muted small mb-3">@Model.Email</p>

                <div>
                    <span class="badge rounded-pill px-3 py-2 fw-medium" style="background-color: #FCEBEB; color: #A32D2D; font-size: 13px;">
                        <i class="bi bi-shield-check me-1"></i> Role: @Model.Role
                    </span>
                    @if (Model.IsCustomer && Model.Points.HasValue)
                    {
                        <div class="mt-3 p-3 rounded-3" style="background-color: #FAF5FF; border: 1px solid #E9D5FF;">
                            <div class="text-secondary small">Reward Points</div>
                            <div class="fs-4 fw-bold" style="color: #6B21A8;">
                                <i class="bi bi-star-fill text-warning me-1"></i> @Model.Points.Value.ToString("N0") pts
                            </div>
                        </div>
                    }
                    else if (Model.IsActive.HasValue)
                    {
                        <div class="mt-3">
                            <span class="badge rounded-pill px-3 py-2" style="background-color: #EAF3DE; color: #27500A;">
                                <i class="bi bi-dot"></i> Active Employee
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Profile Details Card -->
        <div class="col-lg-8">
            <div class="card ds-card shadow-sm p-4">
                <h5 class="fw-semibold text-dark mb-4 pb-2 border-bottom">Personal Information</h5>
                
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted small fw-medium text-uppercase">User ID</div>
                    <div class="col-sm-8 fw-medium text-dark">#@Model.UserId</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted small fw-medium text-uppercase">Full Name</div>
                    <div class="col-sm-8 fw-medium text-dark">@Model.FullName</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted small fw-medium text-uppercase">Email Address</div>
                    <div class="col-sm-8 fw-medium text-dark">
                        @Model.Email
                        <span class="badge bg-light text-secondary border ms-2">Verified</span>
                    </div>
                </div>

                @if (Model.IsCustomer)
                {
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-medium text-uppercase">Phone Number</div>
                        <div class="col-sm-8 fw-medium text-dark">
                            @(string.IsNullOrEmpty(Model.PhoneNumber) ? "(Not provided)" : Model.PhoneNumber)
                        </div>
                    </div>
                }
                else
                {
                    @if (Model.CreatedAt.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted small fw-medium text-uppercase">Member Since</div>
                            <div class="col-sm-8 fw-medium text-dark">@Model.CreatedAt.Value.ToString("dd/MM/yyyy")</div>
                        </div>
                    }
                }

                <hr class="my-4" />

                <!-- Quick Actions Banner -->
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background-color: #F8F9FA;">
                    <div>
                        <div class="fw-semibold text-dark small">Security & Password</div>
                        <div class="text-muted small">Update your password regularly to keep your account safe.</div>
                    </div>
                    <a asp-action="ChangePassword" class="btn btn-sm btn-outline-secondary">
                        Change Password
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
