@model PresentationMVC.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            &larr; Back to Profile
        </a>
        <h2 class="m-0 fw-medium ds-heading-accent">Change Password</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card ds-card shadow-sm p-4">
                <div class="mb-4 text-center">
                    <div class="mx-auto mb-2 d-flex align-items-center justify-content-center rounded-circle"
                         style="width: 54px; height: 54px; background-color: #FCEBEB; color: #A32D2D;">
                        <i class="bi bi-shield-lock fs-4"></i>
                    </div>
                    <h5 class="fw-semibold text-dark mb-1">Set New Security Password</h5>
                    <p class="text-muted small">Choose a strong password with letters, numbers, and symbols</p>
                </div>

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-medium text-dark">New Password <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="NewPassword" class="form-control border-start-0" placeholder="Minimum 8 characters" autofocus autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-medium text-dark">Confirm New Password <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <input asp-for="ConfirmPassword" class="form-control border-start-0" placeholder="Re-enter new password" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-ds-secondary px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-ds-primary px-4">
                            <i class="bi bi-key me-1"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
