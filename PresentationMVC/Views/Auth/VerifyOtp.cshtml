@model PresentationMVC.Models.VerifyOtpViewModel
@{
    Layout = null;
    ViewData["Title"] = "Xác thực OTP";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác thực mã OTP - EDW</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <style>
        .otp-input {
            letter-spacing: 12px;
            font-size: 26px;
            font-weight: 700;
            text-align: center;
        }
    </style>
</head>
<body class="auth-page">
    <div class="auth-wrapper">
        <div class="auth-card shadow-sm">
            <!-- Brand Badge -->
            <div class="text-center">
                <span class="auth-brand-badge">
                    <i class="bi bi-key-fill"></i> Khôi phục mật khẩu (Bước 2/3)
                </span>
            </div>

            <!-- Heading -->
            <h2 class="auth-heading">Nhập mã xác thực OTP</h2>
            <p class="auth-subtext">Mã gồm 6 chữ số đã được gửi đến: <br/><strong class="text-primary">@Model.Email</strong></p>

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info py-2 small">
                    <i class="bi bi-info-circle-fill me-1"></i> @TempData["InfoMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger py-2 small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
                </div>
            }

            <!-- Form Verify OTP -->
            <form asp-action="VerifyOtp" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="UserType" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="mb-4">
                    <label asp-for="Otp" class="form-label fw-semibold small">Mã OTP (6 chữ số)</label>
                    <div class="auth-input-group">
                        <i class="bi bi-shield-check input-icon"></i>
                        <input asp-for="Otp" class="form-control otp-input" placeholder="000000" maxlength="6" autofocus autocomplete="one-time-code" />
                    </div>
                    <span asp-validation-for="Otp" class="field-validation-error"></span>
                    <small class="text-muted d-block mt-2">* Mã OTP có hiệu lực trong 5 phút. Vui lòng kiểm tra cả mục Spam nếu không thấy trong Hộp thư đến.</small>
                </div>

                <button type="submit" class="btn btn-ds-primary w-100 py-2 mb-3">
                    <i class="bi bi-check-circle-fill me-1"></i> Xác nhận mã OTP
                </button>
            </form>

            <!-- Resend OTP Form -->
            <form asp-action="ResendOtp" method="post" class="text-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@Model.Email" />
                <input type="hidden" name="userType" value="@Model.UserType" />
                <button type="submit" class="btn btn-link text-decoration-none small text-secondary">
                    <i class="bi bi-arrow-repeat me-1"></i> Chưa nhận được mã? Gửi lại mã OTP
                </button>
            </form>

            <!-- Quick Links -->
            <div class="auth-links mt-3">
                <a asp-action="ForgotPassword" asp-route-userType="@Model.UserType" class="text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Đổi email khác
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

