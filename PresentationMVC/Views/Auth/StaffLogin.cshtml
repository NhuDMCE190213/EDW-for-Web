@model PresentationMVC.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Staff Portal Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Portal Login - EDW</title>
    <!-- Bootstrap 5 & Bootstrap Icons đồng bộ hệ thống -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <div class="auth-wrapper">
        <div class="auth-card shadow-sm">
            <!-- Brand Badge -->
            <div class="text-center">
                <span class="auth-brand-badge" style="background-color: #F1F5F9; color: #334155;">
                    <i class="bi bi-shield-lock-fill text-danger"></i> EDW Internal Management
                </span>
            </div>

            <!-- Heading -->
            <h2 class="auth-heading">Staff Portal</h2>
            <p class="auth-subtext">Authorized personnel & administration access only</p>

            @if (TempData["SuccessMessage"] is string success)
            {
                <div class="alert alert-success d-flex align-items-center py-2 px-3 mb-3 border-0 rounded-3" style="background-color: #EAF3DE; color: #27500A; font-size: 13px;">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <div>@success</div>
                </div>
            }

            <!-- Form -->
            <form asp-action="StaffLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Employee Email</label>
                    <div class="auth-input-group">
                        <i class="bi bi-person-badge input-icon"></i>
                        <input asp-for="Email" class="form-control" placeholder="staff@edw.com" autofocus autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label mb-0">Password</label>
                        <a asp-action="ForgotPassword" asp-route-userType="Staff" class="text-decoration-none small text-secondary">Forgot password?</a>
                    </div>
                    <div class="auth-input-group">
                        <i class="bi bi-key input-icon"></i>
                        <input asp-for="Password" class="form-control" placeholder="Enter your staff password" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                    <label asp-for="RememberMe" class="form-check-label text-secondary small" for="rememberMe">
                        Keep me signed in on this workstation
                    </label>
                </div>

                <button type="submit" class="btn btn-ds-primary w-100 py-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Staff Portal
                </button>
            </form>

            <!-- Quick Links -->
            <div class="auth-links">
                <div class="border-top my-3"></div>
                <a asp-action="CustomerLogin" class="text-secondary small text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Return to Customer Store
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
