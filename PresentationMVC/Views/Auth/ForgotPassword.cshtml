@model PresentationMVC.Models.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - EDW</title>
    <!-- Bootstrap 5 & Bootstrap Icons đồng bộ hệ thống -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <div class="auth-wrapper">
        <div class="auth-card shadow-sm">
            <!-- Brand Badge -->
            <div class="text-center">
                <span class="auth-brand-badge">
                    <i class="bi bi-question-circle-fill"></i> Password Recovery (Step 1/2)
                </span>
            </div>

            <!-- Heading -->
            <h2 class="auth-heading">Forgot Password</h2>
            <p class="auth-subtext">Enter your registered email address to verify your account</p>

            <!-- Form -->
            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <!-- Account Type Selector -->
                <div class="mb-3">
                    <label class="form-label d-block">Account Type</label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="UserType" value="Customer" id="typeCustomer" checked />
                            <label class="form-check-label small" for="typeCustomer">Customer</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="UserType" value="Staff" id="typeStaff" />
                            <label class="form-check-label small" for="typeStaff">Staff / Admin</label>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Registered Email</label>
                    <div class="auth-input-group">
                        <i class="bi bi-envelope input-icon"></i>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn btn-ds-primary w-100 py-2">
                    <i class="bi bi-arrow-right-circle me-1"></i> Verify Email & Proceed
                </button>
            </form>

            <!-- Quick Links -->
            <div class="auth-links">
                <p class="mb-1">Remember your password? <a asp-action="CustomerLogin">Back to Login</a></p>
                <div class="border-top my-3"></div>
                <a asp-action="StaffLogin" class="text-secondary small text-decoration-none">
                    <i class="bi bi-shield-lock me-1"></i> Staff Login Portal
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
