@model PresentationMVC.Models.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đặt mật khẩu mới";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt mật khẩu mới - EDW</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <div class="auth-wrapper">
        <div class="auth-card shadow-sm">
            <!-- Brand Badge -->
            <div class="text-center">
                <span class="auth-brand-badge">
                    <i class="bi bi-shield-check"></i> Khôi phục mật khẩu (Bước 3/3)
                </span>
            </div>

            <!-- Heading -->
            <h2 class="auth-heading">Đặt lại mật khẩu mới</h2>
            <p class="auth-subtext">Tài khoản xác thực: <strong class="text-dark">@Model.Email</strong></p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success py-2 small">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                </div>
            }

            <!-- Form -->
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="ResetToken" />
                <input type="hidden" asp-for="UserType" />

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small">Mật khẩu mới</label>
                    <div class="auth-input-group">
                        <i class="bi bi-lock input-icon"></i>
                        <input asp-for="Password" class="form-control" placeholder="Tối thiểu 8 ký tự (chữ cái, số, ký tự đặc biệt)" autofocus autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Xác nhận mật khẩu mới</label>
                    <div class="auth-input-group">
                        <i class="bi bi-shield-check input-icon"></i>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn btn-ds-primary w-100 py-2">
                    <i class="bi bi-check2-circle me-1"></i> Cập nhật mật khẩu mới
                </button>
            </form>

            <!-- Quick Links -->
            <div class="auth-links">
                <p class="mb-0"><a asp-action="CustomerLogin">&larr; Hủy thao tác và quay lại Đăng nhập</a></p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
