@model IReadOnlyList<PresentationMVC.Models.ProductVariantModel>
@{
    ViewData["Title"] = "Product Variant Management";
    var productId = (int)(ViewBag.ProductId ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="border-start border-4 border-danger ps-3">Variant List</h2>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-productId="@productId" class="btn btn-danger">Add Variant</a>
        <a asp-action="CreateVariants" asp-route-productId="@productId" class="btn btn-outline-danger">Add Matrix Variants</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>SKU</th><th>Basic Configuration</th><th class="text-end">Price (VND)</th><th class="text-center">Stock</th><th>Promotion</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No variant data yet.</td></tr>
            }
            @foreach (var variant in Model)
            {
                <tr>
                    <td><span class="badge text-bg-light">@variant.Color</span> <span class="badge text-bg-light">@variant.Storage</span><br /><small>@variant.Sku</small></td>
                    <td><small>@if (!string.IsNullOrWhiteSpace(variant.Ram)) { <span class="d-block"><b>RAM:</b> @variant.Ram</span> } @if (!string.IsNullOrWhiteSpace(variant.Cpu)) { <span class="d-block"><b>CPU:</b> @variant.Cpu</span> } @if (!string.IsNullOrWhiteSpace(variant.ScreenSize)) { <span class="d-block"><b>Screen:</b> @variant.ScreenSize</span> }</small></td>
                    <td class="text-end">@variant.Price.ToString("N0") VND</td>
                    <td class="text-center">@if (variant.StockQuantity > 0) { <span class="badge text-bg-success">@variant.StockQuantity</span> } else { <span class="badge text-bg-danger">Out of stock</span> }</td>
                    <td>@variant.Promotion?.Name</td>
                    <td class="text-center text-nowrap">
                        <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#stockModal-@variant.ProductVariantId">Stock in</button>
                        <a asp-action="Edit" asp-route-id="@variant.ProductVariantId" asp-route-productId="@productId" class="btn btn-outline-primary btn-sm">Edit</a>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this variant?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@variant.ProductVariantId" /><input type="hidden" name="productId" value="@productId" />
                            <button class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
                <div class="modal fade" id="stockModal-@variant.ProductVariantId" tabindex="-1">
                    <div class="modal-dialog"><div class="modal-content"><form asp-action="StockIn" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header"><h5 class="modal-title">Stock in @variant.Sku</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                        <div class="modal-body"><input type="hidden" name="id" value="@variant.ProductVariantId" /><input type="hidden" name="productId" value="@productId" /><label class="form-label">Increase amount</label><input class="form-control" type="number" name="increaseAmount" min="1" required /></div>
                        <div class="modal-footer"><button class="btn btn-primary">Save</button></div>
                    </form></div></div>
                </div>
            }
            </tbody>
        </table>
    </div>
</div>
