@model PresentationMVC.Models.Order.Customer.MyOrdersViewModel
@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    string GetStatusClass(string status) => status.ToLower() switch
    {
        "pending"    => "status-pending",
        "processing" => "status-processing",
        "confirmed"  => "status-confirmed",
        "shipped"    => "status-shipped",
        "completed"  => "status-completed",
        "cancelled"  => "status-cancelled",
        _            => "status-other"
    };

    string GetStatusIcon(string status) => status.ToLower() switch
    {
        "pending"    => "bi-hourglass-split",
        "processing" => "bi-arrow-repeat",
        "confirmed"  => "bi-check-circle-fill",
        "shipped"    => "bi-truck",
        "completed"  => "bi-bag-check-fill",
        "cancelled"  => "bi-x-circle-fill",
        _            => "bi-circle"
    };

    bool CanCancel(string s)   => s is "Pending" or "Processing" or "Confirmed";
    bool CanTransfer(string s) => s is "Cancelled" or "Pending";
}

@section Styles {
<style>
/* ── Hero ─────────────────────────────────────────────── */
.orders-hero {
    background: linear-gradient(135deg, var(--customer-primary) 0%, var(--customer-primary-dark) 100%);
    border-radius: 20px;
    color: #fff;
    padding: 32px 36px;
    margin-bottom: 32px;
    position: relative;
    overflow: hidden;
}
.orders-hero::before, .orders-hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: rgba(255,255,255,.07);
}
.orders-hero::before { width:220px; height:220px; top:-60px; right:-40px; }
.orders-hero::after  { width:120px; height:120px; bottom:-30px; right:120px; }

.stat-chip {
    background: rgba(255,255,255,.18);
    border-radius: 12px;
    padding: 12px 20px;
    min-width: 120px;
    text-align: center;
    backdrop-filter: blur(6px);
}
.stat-chip .val  { font-size:1.5rem; font-weight:700; line-height:1.1; }
.stat-chip .lbl  { font-size:.7rem; opacity:.85; text-transform:uppercase; letter-spacing:.06em; }

/* ── Filter tabs ──────────────────────────────────────── */
.filter-tabs { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px; }
.filter-tab  {
    border: 1.5px solid #e5e5e5; border-radius:999px;
    padding: 6px 18px; font-size:.82rem; font-weight:600;
    cursor:pointer; background:#fff; transition: all .15s;
    color: #555;
}
.filter-tab:hover          { border-color: var(--customer-primary); color: var(--customer-primary-dark); }
.filter-tab.active         { background: var(--customer-primary); border-color: var(--customer-primary); color:#fff; }

/* ── Order card ───────────────────────────────────────── */
.order-card {
    border: 1.5px solid #eee;
    border-radius: 16px;
    margin-bottom: 14px;
    background: #fff;
    overflow: hidden;
    transition: box-shadow .2s;
}
.order-card:hover { box-shadow: 0 6px 28px rgba(0,0,0,.07); }

.order-card-head {
    display: flex; flex-wrap: wrap; align-items: center; gap:12px;
    padding: 18px 22px; cursor: pointer; user-select:none;
}
.order-card-head:hover { background: #fafafa; }

.order-id   { font-family:monospace; font-size:.77rem; background:#f4f4f5; border-radius:6px; padding:2px 8px; color:#777; }
.order-date { font-size:.78rem; color:#aaa; }
.order-amt  { font-size:1.05rem; font-weight:700; color: var(--customer-primary-dark); margin-left:auto; margin-right:6px; }
.chevron    { color:#ccc; transition:transform .25s; flex-shrink:0; }
.order-card.open .chevron { transform: rotate(180deg); }

/* ── Status badges ─────────────────────────────────────── */
.s-badge {
    border-radius:999px; padding:4px 13px; font-size:.73rem;
    font-weight:600; display:inline-flex; align-items:center; gap:5px;
    border: 1.5px solid transparent;
}
.status-pending    { background:#fff8e1; color:#d08700; border-color:#f0c840; }
.status-processing { background:#e3f4fd; color:#0178a8; border-color:#7ad4f5; }
.status-confirmed  { background:#e8eeff; color:#3b5bdb; border-color:#91a7ff; }
.status-shipped    { background:#f2f2f2; color:#555;    border-color:#ccc; }
.status-completed  { background:#ebfbee; color:#2b7a3e; border-color:#69db7c; }
.status-cancelled  { background:#fff5f5; color:#c92a2a; border-color:#ff8787; }
.status-other      { background:#f8f9fa; color:#666; }

/* ── Detail panel ──────────────────────────────────────── */
.order-detail {
    border-top: 1.5px solid #f0f0f0;
    background: #fafafa;
    padding: 22px 22px 18px;
    display: none;
}
.order-card.open .order-detail { display: block; }

.items-tbl th { font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; color:#aaa; font-weight:700; }
.items-tbl td { font-size:.87rem; }
.tfoot-total  { font-size:1rem; font-weight:700; color: var(--customer-primary-dark); }

/* ── Action buttons ────────────────────────────────────── */
.act-btn {
    border-radius: 9px; font-size:.82rem; font-weight:600;
    padding: 7px 16px; border: 1.5px solid transparent;
    transition: transform .12s, opacity .15s; display:inline-flex; align-items:center; gap:6px;
}
.act-btn:hover  { transform:translateY(-1px); opacity:.9; }
.act-btn:active { transform:translateY(0); }

.btn-cancel   { background:#fff3f3; color:#d63031; border-color:#ff7675; }
.btn-cancel:hover { background:#ffe0e0; }

.btn-transfer { background:#f0f9ff; color:#0078d4; border-color:#74b9ff; }
.btn-transfer:hover { background:#dcf0ff; }

.btn-shop     { background: var(--customer-primary); color:#fff; border-color: var(--customer-primary); }
.btn-shop:hover { background: #c0392b; border-color:#c0392b; }

/* ── Empty state ───────────────────────────────────────── */
.empty-state { text-align:center; padding:70px 20px; }
.empty-state i { font-size:4rem; color:#ddd; }
.empty-state h4 { font-weight:700; color:#333; margin-top:14px; }
.empty-state p  { color:#aaa; }
</style>
}

@* ── CSRF token (used by AJAX) ──────────────────────────────────────────── *@
@Html.AntiForgeryToken()

@* ── Hero Stats ─────────────────────────────────────────────────────────── *@
<div class="orders-hero">
    <div class="d-flex align-items-center gap-3 mb-2">
        <i class="bi bi-bag-check-fill fs-4"></i>
        <div>
            <h4 class="fw-bold mb-0">My Orders</h4>
            <p class="mb-0" style="opacity:.85; font-size:.9rem;">Hello, <strong>@Model.CustomerName</strong> — here are all your orders.</p>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-3 mt-3">
        <div class="stat-chip">
            <div class="val">@Model.TotalOrders</div>
            <div class="lbl">Total Orders</div>
        </div>
        <div class="stat-chip">
            <div class="val">@Model.Orders.Count(o => o.Status == "Pending")</div>
            <div class="lbl">Pending</div>
        </div>
        <div class="stat-chip">
            <div class="val">@Model.Orders.Count(o => o.Status == "Completed")</div>
            <div class="lbl">Completed</div>
        </div>
        <div class="stat-chip">
            <div class="val">@Model.TotalSpent.ToString("N0") ₫</div>
            <div class="lbl">Total Spent</div>
        </div>
    </div>
</div>

@if (!Model.Orders.Any())
{
    <div class="empty-state">
        <i class="bi bi-bag"></i>
        <h4>No Orders Yet</h4>
        <p>Your orders will appear here after your first purchase.</p>
        <a asp-controller="Home" asp-action="Index" class="btn act-btn btn-shop mt-2">
            <i class="bi bi-bag-heart"></i> Start Shopping
        </a>
    </div>
}
else
{
    @* ── Filter Tabs ──────────────────────────────────────────────────────── *@
    <div class="filter-tabs" id="filterTabs">
        <button class="filter-tab active" data-filter="all" onclick="filterOrders('all', this)">
            All <span class="badge bg-secondary ms-1">@Model.Orders.Count</span>
        </button>
        @foreach (var grp in Model.Orders.GroupBy(o => o.Status).OrderBy(g => g.Key))
        {
            <button class="filter-tab" data-filter="@grp.Key.ToLower()" onclick="filterOrders('@grp.Key.ToLower()', this)">
                @grp.Key <span class="badge bg-secondary ms-1">@grp.Count()</span>
            </button>
        }
    </div>

    @* ── Order Cards ──────────────────────────────────────────────────────── *@
    <div id="ordersContainer">
        @foreach (var order in Model.Orders)
        {
            var cid = "oc-" + order.OrderId.ToString("N");
            <div class="order-card" id="@cid" data-status="@order.Status.ToLower()">

                @* Header (click to expand) *@
                <div class="order-card-head" onclick="toggleCard('@cid')">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi @GetStatusIcon(order.Status)" style="font-size:1rem;"></i>
                            <span class="fw-semibold text-dark" style="font-size:.95rem;">Order</span>
                            <span class="order-id">@order.OrderId.ToString().Substring(0,8).ToUpper()…</span>
                        </div>
                        <div class="order-date">
                            @order.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                            &nbsp;·&nbsp; @order.OrderItems.Count item(s)
                        </div>
                    </div>

                    <span class="s-badge @GetStatusClass(order.Status)">
                        <i class="bi @GetStatusIcon(order.Status)"></i> @order.Status
                    </span>

                    <span class="order-amt">@order.TotalAmount.ToString("N0") ₫</span>
                    <i class="bi bi-chevron-down chevron fs-5"></i>
                </div>

                @* Detail panel *@
                <div class="order-detail">

                    @* Items table *@
                    <h6 class="fw-semibold text-dark mb-3">
                        <i class="bi bi-list-ul me-1"></i> Order Items
                    </h6>
                    <div class="table-responsive mb-4">
                        <table class="table items-tbl align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-0">Product</th>
                                    <th>Variant</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end pe-0">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.OrderItems)
                                {
                                    <tr>
                                        <td class="ps-0">
                                            <div class="fw-semibold text-dark">@item.ProductName</div>
                                            <div class="text-muted" style="font-size:.74rem;">Item #@item.OrderItemId</div>
                                        </td>
                                        <td class="text-muted">@item.ProductVariantDetails</td>
                                        <td class="text-end">@item.Quantity</td>
                                        <td class="text-end">@item.PriceAtPurchase.ToString("N0") ₫</td>
                                        <td class="text-end pe-0 fw-semibold" style="color:var(--color-primary);">
                                            @item.Subtotal.ToString("N0") ₫
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="border-top">
                                <tr>
                                    <td colspan="4" class="text-end fw-bold ps-0">Total</td>
                                    <td class="text-end tfoot-total pe-0">@order.TotalAmount.ToString("N0") ₫</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    @* Action row *@
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @if (CanCancel(order.Status))
                        {
                            <button type="button"
                                    class="btn act-btn btn-cancel"
                                    id="btn-cancel-@order.OrderId.ToString("N")"
                                    onclick="cancelOrder('@order.OrderId')">
                                <i class="bi bi-x-circle"></i> Cancel Order
                            </button>
                        }

                        @if (CanTransfer(order.Status))
                        {
                            <button type="button"
                                    class="btn act-btn btn-transfer"
                                    id="btn-transfer-@order.OrderId.ToString("N")"
                                    onclick="transferToCart('@order.OrderId')">
                                <i class="bi bi-cart-plus"></i> Transfer to Cart
                            </button>
                        }

                        <a asp-controller="Home" asp-action="Index"
                           class="btn act-btn btn-shop ms-auto">
                            <i class="bi bi-bag-heart"></i> Continue Shopping
                        </a>
                    </div>

                    @* Order meta *@
                    <div class="mt-3 pt-3 border-top" style="font-size:.75rem; color:#bbb;">
                        <span class="me-4"><strong>Order ID:</strong> @order.OrderId</span>
                        @if (order.UpdatedAt.HasValue)
                        {
                            <span><strong>Last updated:</strong> @order.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm")</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* Empty filter state *@
    <div id="filterEmpty" style="display:none;" class="empty-state">
        <i class="bi bi-funnel"></i>
        <h4>No Orders Found</h4>
        <p>No orders match this status filter.</p>
    </div>
}

@section Scripts {
<script>
    // ── Accordion ──────────────────────────────────────────────────────────
    function toggleCard(id) {
        const card = document.getElementById(id);
        card.classList.toggle('open');
    }

    // ── Status Filter ──────────────────────────────────────────────────────
    function filterOrders(status, btn) {
        // Update active tab
        document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');

        const cards = document.querySelectorAll('.order-card');
        let visible = 0;
        cards.forEach(c => {
            const match = status === 'all' || c.dataset.status === status;
            c.style.display = match ? '' : 'none';
            if (match) visible++;
        });

        document.getElementById('filterEmpty').style.display = visible === 0 ? 'block' : 'none';
    }

    // ── CSRF helper ────────────────────────────────────────────────────────
    function csrf() {
        return document.querySelector('input[name="__RequestVerificationToken"]').value;
    }

    // ── Cancel Order ───────────────────────────────────────────────────────
    function cancelOrder(orderId) {
        if (!confirm('Are you sure you want to cancel this order?\nThis action will restore your stock.')) return;

        const key = orderId.replace(/-/g, '');
        const btn = document.getElementById('btn-cancel-' + key);
        if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Cancelling…'; }

        $.ajax({
            url: '@Url.Action("Cancel", "Orders")',
            type: 'POST',
            data: { orderId, __RequestVerificationToken: csrf() },
            success: function (res) {
                if (res.success) {
                    showToast(res.message, 'success', 'Order Cancelled');
                    setTimeout(() => location.reload(), 1600);
                } else {
                    showToast(res.message, 'error', 'Cancel Failed');
                    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-x-circle"></i> Cancel Order'; }
                }
            },
            error: function () {
                showToast('Network error. Please try again.', 'error', 'Error');
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-x-circle"></i> Cancel Order'; }
            }
        });
    }

    // ── Transfer to Cart ───────────────────────────────────────────────────
    function transferToCart(orderId) {
        if (!confirm('Transfer all items from this order to your cart?')) return;

        const key = orderId.replace(/-/g, '');
        const btn = document.getElementById('btn-transfer-' + key);
        if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Transferring…'; }

        $.ajax({
            url: '@Url.Action("TransferToCart", "Orders")',
            type: 'POST',
            data: { orderId, __RequestVerificationToken: csrf() },
            success: function (res) {
                if (res.success) {
                    showToast(res.message, 'success', 'Transferred to Cart');
                    setTimeout(() => window.location.href = '@Url.Action("Index", "Cart")', 1800);
                } else {
                    showToast(res.message, 'error', 'Transfer Failed');
                    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-cart-plus"></i> Transfer to Cart'; }
                }
            },
            error: function () {
                showToast('Network error. Please try again.', 'error', 'Error');
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-cart-plus"></i> Transfer to Cart'; }
            }
        });
    }
</script>
}